                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="通常スコア差" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       FontSize="12" FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding ChartDetailLatestPlay.ScoreBestDeltaDisplay, Mode=OneWay}"
                                                                       Style="{StaticResource HomeDeltaTextStyle}"
                                                                       Tag="{Binding ChartDetailLatestPlay.ScoreBestDeltaGroup, Mode=OneWay}" />
