                                                <WrapPanel Margin="0,4,0,0">
                                                    <TextBlock Text="EX SCORE " Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="12" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding ChartDetailLatestPlay.ExScoreDisplay, Mode=OneWay}"
                                                               FontFamily="Segoe UI Variable, Segoe UI" Typography.NumeralAlignment="Tabular" FontWeight="Bold" />
                                                </WrapPanel>
                                                <WrapPanel Margin="0,10,0,0">
                                                    <ContentControl Content="{Binding ChartDetailLatestPlay, Mode=OneWay}"
