                                        <Border Style="{StaticResource DifficultyBadgeStyle}" Margin="0,0,10,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Difficulty}"
                                                       Style="{StaticResource DifficultyBadgeTextStyle}" />
                                        </Border>
                                        <TextBlock Text="{Binding PlayStyleDisplay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Text="/" Margin="6,0" VerticalAlignment="Center"
