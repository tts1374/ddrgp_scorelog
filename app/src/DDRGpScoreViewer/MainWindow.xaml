                    <Border Grid.Row="2" CornerRadius="0,0,5,5" MinHeight="64" Padding="12,8" Background="{DynamicResource SurfaceSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0,1,0,0">
