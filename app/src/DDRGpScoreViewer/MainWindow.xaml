                        <Style TargetType="Button" BasedOn="{StaticResource HomeSectionLinkStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=ContentTabs, Path=SelectedIndex}" Value="2">
