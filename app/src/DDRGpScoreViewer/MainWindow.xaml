                                    <DataGridTextColumn ElementStyle="{StaticResource HistoryNumberTextStyle}" HeaderStyle="{StaticResource HistoryNumberHeaderStyle}" Header="SCORE" Binding="{Binding ScoreDisplay, Mode=OneWay}" Width="110" />
                                    <DataGridTextColumn ElementStyle="{StaticResource HistoryNumberTextStyle}" HeaderStyle="{StaticResource HistoryNumberHeaderStyle}" Header="EX SCORE" Binding="{Binding ExScoreDisplay, Mode=OneWay}" Width="92" />
                                    <DataGridTemplateColumn Header="ランク" Width="76">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl Content="{Binding}"
                                                                ContentTemplate="{StaticResource RankBadgeOrPlaceholderTemplate}"
                                                                HorizontalContentAlignment="Left"
                                                                VerticalContentAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="CLEAR" MinWidth="92" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl Content="{Binding}"
                                                                ContentTemplate="{StaticResource ClearBadgeOrPlaceholderTemplate}"
                                                                HorizontalContentAlignment="Left"
                                                                VerticalContentAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="FLARE" MinWidth="100" Width="102">
