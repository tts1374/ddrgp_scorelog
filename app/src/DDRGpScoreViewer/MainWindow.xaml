                               FontSize="13" />
                    <TextBlock Text="{Binding UnresolvedNotificationMessage}"
                               Foreground="{DynamicResource NotificationWarningTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
