<Window x:Class="DDRGpScoreViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DDRGpScoreViewer.Controls"
        xmlns:models="clr-namespace:DDRGpScoreViewer.Models"
        Title="GP Score Log" Icon="Assets/GPScoreLog.ico" Width="1280" Height="760"
        Style="{StaticResource {x:Type Window}}"
        MinWidth="960" MinHeight="640" WindowStartupLocation="CenterScreen"
        SizeChanged="MainWindow_SizeChanged"
        Loaded="MainWindow_Loaded">
    <Window.Resources>
        <Style x:Key="TableTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>

        <DataTemplate x:Key="FlareBadgeOrPlaceholderTemplate">
            <Grid>
                <Border x:Name="FlareBadge" Style="{StaticResource FlareBadgeStyle}"
                        Tag="{Binding FlareBadgeGroup, Mode=OneWay}">
                    <TextBlock Text="{Binding FlareRankDisplay, Mode=OneWay}"
                               Style="{StaticResource BadgeTextStyle}" />
                </Border>
                <TextBlock x:Name="FlarePlaceholder" Text="—" Visibility="Collapsed"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12" VerticalAlignment="Center" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding FlareBadgeGroup}" Value="None">
                    <Setter TargetName="FlareBadge" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="FlarePlaceholder" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="RankBadgeOrPlaceholderTemplate">
            <Grid>
                <Border x:Name="RankBadge" Style="{StaticResource RankBadgeStyle}"
                        Tag="{Binding RankBadgeGroup, Mode=OneWay}">
                    <TextBlock Text="{Binding RankDisplay, Mode=OneWay}"
                               Style="{StaticResource BadgeTextStyle}" />
                </Border>
                <TextBlock x:Name="RankPlaceholder" Text="—" Visibility="Collapsed"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12" VerticalAlignment="Center" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasRank, Mode=OneWay}" Value="False">
                    <Setter TargetName="RankBadge" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="RankPlaceholder" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ClearBadgeOrPlaceholderTemplate">
            <Grid>
                <Border x:Name="ClearBadge" Style="{StaticResource ClearBadgeStyle}"
                        Tag="{Binding ClearBadgeGroup, Mode=OneWay}">
                    <TextBlock Text="{Binding ClearDisplay, Mode=OneWay}"
                               Style="{StaticResource BadgeTextStyle}" />
                </Border>
                <TextBlock x:Name="ClearPlaceholder" Text="—" Visibility="Collapsed"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12" VerticalAlignment="Center" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasClear, Mode=OneWay}" Value="False">
                    <Setter TargetName="ClearBadge" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ClearPlaceholder" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="HomeSectionLinkStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsEnabled" Value="True" />
                        <Condition Property="IsMouseOver" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
                </MultiTrigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsEnabled" Value="True" />
                        <Condition Property="IsPressed" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource AccentPressedBrush}" />
                </MultiTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                    <Setter Property="Cursor" Value="Arrow" />
                    <Setter Property="Opacity" Value="0.6" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HomeSummaryCopyButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CopyButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="CopyButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentSubtleBrush}" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled" Value="True" />
                                    <Condition Property="IsPressed" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="CopyButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentPressedBrush}" />
                                <Setter TargetName="CopyButtonBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentPressedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CopyButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource SurfaceSecondaryBrush}" />
                                <Setter TargetName="CopyButtonBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource BorderDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HomeSummaryCardStyle" TargetType="Border"
               BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="14,14" />
            <Setter Property="MinHeight" Value="100" />
        </Style>

        <Style x:Key="HomeDeltaChipStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource SegmentBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Up">
                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Down">
                    <Setter Property="Background" Value="{DynamicResource DeltaDangerBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DeltaDangerBorderBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="First">
                    <Setter Property="Background" Value="{DynamicResource DeltaFirstBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DeltaFirstBorderBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource DeltaFirstTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HomeDeltaTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Up">
                    <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Down">
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="First">
                    <Setter Property="Foreground" Value="{DynamicResource DeltaFirstTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BestStyleButtonStyle" TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource SegmentBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SegmentBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Padding" Value="14,6" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="Selected">
                    <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BestSegmentButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SegmentButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="SegmentButtonBorder" Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled" Value="True" />
                                    <Condition Property="IsPressed" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="SegmentButtonBorder" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                            </MultiTrigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="SegmentButtonBorder" Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
                                <Setter TargetName="SegmentButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Selected" />
                                    <Condition Property="IsEnabled" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="SegmentButtonBorder" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Selected" />
                                    <Condition Property="IsEnabled" Value="True" />
                                    <Condition Property="IsPressed" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="SegmentButtonBorder" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SegmentButtonBorder" Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                <Setter Property="Opacity" Value="0.6" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BestBrowseTabButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BrowseTabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="BrowseTabBorder" Property="Background"
                                        Value="{DynamicResource AccentPrimaryBrush}" />
                                <Setter TargetName="BrowseTabBorder" Property="BorderBrush"
                                        Value="{DynamicResource AccentPrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="BrowseTabBorder" Property="BorderBrush"
                                        Value="{DynamicResource AccentPrimaryBrush}" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled" Value="True" />
                                    <Condition Property="IsPressed" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="BrowseTabBorder" Property="Background"
                                        Value="{DynamicResource AccentPressedBrush}" />
                                <Setter TargetName="BrowseTabBorder" Property="BorderBrush"
                                        Value="{DynamicResource AccentPressedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Selected" />
                                    <Condition Property="IsEnabled" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="BrowseTabBorder" Property="Background"
                                        Value="{DynamicResource AccentPrimaryBrush}" />
                                <Setter TargetName="BrowseTabBorder" Property="BorderBrush"
                                        Value="{DynamicResource AccentPrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Selected" />
                                    <Condition Property="IsEnabled" Value="True" />
                                    <Condition Property="IsPressed" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="BrowseTabBorder" Property="Background"
                                        Value="{DynamicResource AccentPressedBrush}" />
                                <Setter TargetName="BrowseTabBorder" Property="BorderBrush"
                                        Value="{DynamicResource AccentPressedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BrowseTabBorder" Property="Background"
                                        Value="{DynamicResource SurfaceSecondaryBrush}" />
                                <Setter TargetName="BrowseTabBorder" Property="BorderBrush"
                                        Value="{DynamicResource BorderDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BestAxisChangeButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="AxisChangeBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="AxisChangeBorder" Property="Background"
                                        Value="{DynamicResource AccentSubtleBrush}" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled" Value="True" />
                                    <Condition Property="IsPressed" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="AxisChangeBorder" Property="Background"
                                        Value="{DynamicResource AccentPressedBrush}" />
                                <Setter TargetName="AxisChangeBorder" Property="BorderBrush"
                                        Value="{DynamicResource AccentPressedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="AxisChangeBorder" Property="Background"
                                        Value="{DynamicResource SurfaceSecondaryBrush}" />
                                <Setter TargetName="AxisChangeBorder" Property="BorderBrush"
                                        Value="{DynamicResource BorderDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BestTitleSearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TitleSearchBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TitleSearchBorder" Property="BorderBrush"
                                        Value="{DynamicResource BorderStrongBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TitleSearchBorder" Property="BorderBrush"
                                        Value="{DynamicResource FocusRingBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TitleSearchBorder" Property="Background"
                                        Value="{DynamicResource SurfaceSecondaryBrush}" />
                                <Setter TargetName="TitleSearchBorder" Property="BorderBrush"
                                        Value="{DynamicResource BorderDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BestAxisOptionStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="AxisOptionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="AxisOptionBorder" Property="BorderBrush"
                                        Value="{DynamicResource AccentPrimaryBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="AxisOptionBorder" Property="Background"
                                        Value="{DynamicResource SurfaceSecondaryBrush}" />
                                <Setter TargetName="AxisOptionBorder" Property="BorderBrush"
                                        Value="{DynamicResource BorderDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                <Setter Property="Opacity" Value="0.6" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSinglePlayStyleButtonStyle" TargetType="Button"
               BasedOn="{StaticResource BestStyleButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DefaultPlayStyle}" Value="SINGLE">
                    <Setter Property="Tag" Value="Selected" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsDoublePlayStyleButtonStyle" TargetType="Button"
               BasedOn="{StaticResource BestStyleButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DefaultPlayStyle}" Value="DOUBLE">
                    <Setter Property="Tag" Value="Selected" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MonitoringStateIndicatorStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource MonitoringInfoBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentMonitoringState}"
                             Value="{x:Static models:MonitoringState.Starting}">
                    <Setter Property="Fill" Value="{DynamicResource MonitoringWarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentMonitoringState}"
                             Value="{x:Static models:MonitoringState.SelectingTarget}">
                    <Setter Property="Fill" Value="{DynamicResource MonitoringWarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentMonitoringState}"
                             Value="{x:Static models:MonitoringState.Monitoring}">
                    <Setter Property="Fill" Value="{DynamicResource MonitoringSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentMonitoringState}"
                             Value="{x:Static models:MonitoringState.Stopping}">
                    <Setter Property="Fill" Value="{DynamicResource MonitoringWarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentMonitoringState}"
                             Value="{x:Static models:MonitoringState.Stopped}">
                    <Setter Property="Fill" Value="{DynamicResource MonitoringNeutralBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentMonitoringState}"
                             Value="{x:Static models:MonitoringState.ManuallyStopped}">
                    <Setter Property="Fill" Value="{DynamicResource MonitoringNeutralBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentMonitoringState}"
                             Value="{x:Static models:MonitoringState.Blocked}">
                    <Setter Property="Fill" Value="{DynamicResource MonitoringErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentMonitoringState}"
                             Value="{x:Static models:MonitoringState.CaptureFailed}">
                    <Setter Property="Fill" Value="{DynamicResource MonitoringErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentMonitoringState}"
                             Value="{x:Static models:MonitoringState.WorkflowFailed}">
                    <Setter Property="Fill" Value="{DynamicResource MonitoringErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentMonitoringState}"
                             Value="{x:Static models:MonitoringState.TargetClosed}">
                    <Setter Property="Fill" Value="{DynamicResource MonitoringErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentMonitoringState}"
                             Value="{x:Static models:MonitoringState.Resized}">
                    <Setter Property="Fill" Value="{DynamicResource MonitoringErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentMonitoringState}"
                             Value="{x:Static models:MonitoringState.DeviceLost}">
                    <Setter Property="Fill" Value="{DynamicResource MonitoringErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentMonitoringState}"
                             Value="{x:Static models:MonitoringState.ShuttingDown}">
                    <Setter Property="Fill" Value="{DynamicResource MonitoringShuttingDownBrush}" />
                </DataTrigger>
            </Style.Triggers>
