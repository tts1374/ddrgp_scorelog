                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="今日のプレー状況" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                        <TextBlock Text="{Binding HomeTodayDateDisplay}" Style="{StaticResource ScorebookCaptionStyle}" Margin="0,4,0,0" />
                                        <TextBlock Text="プレー記録（07:00切り替え）" Style="{StaticResource ScorebookCaptionStyle}" />
                                    </StackPanel>
<StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center"><TextBlock Text="プレー数" Style="{StaticResource ScorebookCaptionStyle}"  /><TextBlock Text="{Binding HomeTodayPlayCount}" Style="{StaticResource ScorebookNumberStyle}" FontSize="28" /></StackPanel><StackPanel Grid.Column="2" Margin="20,0,0,0" VerticalAlignment="Center"><TextBlock Text="総ノーツ数" Style="{StaticResource ScorebookCaptionStyle}"  /><TextBlock Text="{Binding HomeTodayTotalNotesDisplay}" Style="{StaticResource ScorebookNumberStyle}" FontSize="28" /></StackPanel><StackPanel Grid.Column="3" Margin="20,0,0,0" VerticalAlignment="Center"><TextBlock Text="消費カロリー" Style="{StaticResource ScorebookCaptionStyle}"  /><TextBlock Text="{Binding HomeTodayCaloriesDisplay}" Style="{StaticResource ScorebookNumberStyle}" FontSize="28" /></StackPanel>
                                    <Button x:Name="HomeSummaryCopyButton" Grid.Column="4" Content="振り返りをコピー" TabIndex="100" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Margin="16,0,0,0" Click="CopyHomeSummary_Click" />
