        <Style x:Key="FlareSkillDifficultyBadgeStyle" TargetType="Border">
            <Setter Property="MinWidth" Value="31" />
            <Setter Property="Height" Value="17" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Difficulty}" Value="BEGINNER"><Setter Property="Background" Value="{DynamicResource BeginnerBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Difficulty}" Value="BASIC"><Setter Property="Background" Value="{DynamicResource BasicBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Difficulty}" Value="DIFFICULT"><Setter Property="Background" Value="{DynamicResource DifficultBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Difficulty}" Value="EXPERT"><Setter Property="Background" Value="{DynamicResource ExpertBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Difficulty}" Value="CHALLENGE"><Setter Property="Background" Value="{DynamicResource ChallengeBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FlareSkillDifficultyTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Difficulty}" Value="BEGINNER"><Setter Property="Foreground" Value="#0B2330" /></DataTrigger>
                <DataTrigger Binding="{Binding Difficulty}" Value="BASIC"><Setter Property="Foreground" Value="#2B1A00" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FlareSkillResultBadgeStyle" TargetType="Border"
               BasedOn="{StaticResource FlareBadgeStyle}">
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="MinHeight" Value="19" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="FlareRankTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FlareRankNoneBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding FlareRankMainDisplay}" Value="MERCURY"><Setter Property="Foreground" Value="{DynamicResource FlareRankMercuryBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding FlareRankMainDisplay}" Value="VENUS"><Setter Property="Foreground" Value="{DynamicResource FlareRankVenusBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding FlareRankMainDisplay}" Value="EARTH"><Setter Property="Foreground" Value="{DynamicResource FlareRankEarthBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding FlareRankMainDisplay}" Value="MARS"><Setter Property="Foreground" Value="{DynamicResource FlareRankMarsBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding FlareRankMainDisplay}" Value="JUPITER"><Setter Property="Foreground" Value="{DynamicResource FlareRankJupiterBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding FlareRankMainDisplay}" Value="SATURN"><Setter Property="Foreground" Value="{DynamicResource FlareRankSaturnBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding FlareRankMainDisplay}" Value="URANUS"><Setter Property="Foreground" Value="{DynamicResource FlareRankUranusBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding FlareRankMainDisplay}" Value="NEPTUNE"><Setter Property="Foreground" Value="{DynamicResource FlareRankNeptuneBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding FlareRankMainDisplay}" Value="SUN"><Setter Property="Foreground" Value="{DynamicResource FlareRankSunBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding FlareRankMainDisplay}" Value="WORLD"><Setter Property="Foreground" Value="{DynamicResource FlareRankWorldBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FlareRankProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="7" />
            <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" CornerRadius="4" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="FlareSkillCategoryTemplate">
            <Border Margin="6,0" Padding="0" Background="{DynamicResource SurfacePrimaryBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border MinHeight="73" Padding="14,12" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="5" Height="36" Margin="0,0,9,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource FlareClassicCategoryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Name}" Value="WHITE">
                                                    <Setter Property="Background" Value="{DynamicResource FlareWhiteCategoryBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Name}" Value="GOLD"><Setter Property="Background" Value="{DynamicResource FlareGoldCategoryBrush}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" />
                                    <TextBlock Text="{Binding VersionRange}" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding TotalDisplay}" FontSize="21" FontWeight="Bold"
                                           TextAlignment="Right" Typography.NumeralAlignment="Tabular" />
                                <TextBlock Text="{Binding CountDisplay}" FontSize="11" TextAlignment="Right"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding TopCharts}" AlternationCount="5">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border MinHeight="61" Padding="8,8,10,8" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,0,0,1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
                                                <Style.Triggers>
                                                    <Trigger Property="ItemsControl.AlternationIndex" Value="4"><Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" /></Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" /></Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding PositionDisplay}" FontSize="11" TextAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SongTitle}" FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding SongTitle}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Border Style="{StaticResource FlareSkillDifficultyBadgeStyle}">
                                                        <TextBlock Text="{Binding DifficultyShortDisplay}" Style="{StaticResource FlareSkillDifficultyTextStyle}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding LevelDisplay}" FontSize="10" FontWeight="SemiBold" Margin="6,0,0,0"
                                                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" MinWidth="53" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Border Style="{StaticResource FlareSkillResultBadgeStyle}" Tag="{Binding FlareBadgeGroup}">
                                                    <TextBlock Text="{Binding FlareRankDisplay}" FontSize="9" FontWeight="ExtraBold" />
                                                </Border>
                                                <TextBlock Text="{Binding FlareSkillDisplay}" FontSize="15" FontWeight="Bold" Margin="0,3,0,0"
                                                           HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Row="1" Text="対象実績なし" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TopCharts.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Grid.Row="2" MinHeight="54" Padding="10,7" Background="{DynamicResource SurfaceSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0,1,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRunnerUp}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid DataContext="{Binding RunnerUp}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Padding="6,3" Background="{DynamicResource SurfacePrimaryBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                                    BorderThickness="1" CornerRadius="4" VerticalAlignment="Center">
                                <TextBlock Text="次点 31位" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SongTitle}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <Border Style="{StaticResource FlareSkillDifficultyBadgeStyle}">
                                        <TextBlock Text="{Binding DifficultyShortDisplay}" Style="{StaticResource FlareSkillDifficultyTextStyle}" />
                                    </Border>
                                    <TextBlock Text="{Binding LevelDisplay}" FontSize="10" FontWeight="SemiBold" Margin="6,0,0,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" MinWidth="53" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border Style="{StaticResource FlareSkillResultBadgeStyle}" Tag="{Binding FlareBadgeGroup}">
                                    <TextBlock Text="{Binding FlareRankDisplay}" FontSize="9" FontWeight="ExtraBold" />
                                </Border>
                                <TextBlock Text="{Binding FlareSkillDisplay}" FontSize="14" FontWeight="Bold" Margin="0,3,0,0"
                                           HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid MinWidth="0" MinHeight="0" Background="{DynamicResource BackgroundPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,0,0,1" Padding="32,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="GP Score Log" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
<Button x:Name="HomeNavigation" Content="ホーム" TabIndex="0" Tag="Selected" Padding="9,18" Style="{StaticResource SidebarButtonStyle}" Click="ShowHome_Click" />
<Button x:Name="BestNavigation" Content="自己ベスト" TabIndex="1" Padding="9,18" Style="{StaticResource SidebarButtonStyle}" Click="ShowBest_Click" />
<Button x:Name="HistoryNavigation" Content="直近プレー履歴" TabIndex="2" Padding="9,18" Style="{StaticResource SidebarButtonStyle}" Click="ShowHistory_Click" />
<Button x:Name="FlareSkillNavigation" Content="フレアスキル" TabIndex="3" Padding="9,18" Style="{StaticResource SidebarButtonStyle}" Click="ShowFlareSkill_Click" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
<Button x:Name="SettingsNavigation" Content="設定" TabIndex="4" Padding="9,18" Style="{StaticResource SidebarButtonStyle}" Click="ShowSettings_Click" />
<Button x:Name="DataManagementNavigation" Content="データ管理" TabIndex="5" Padding="9,18" Style="{StaticResource SidebarButtonStyle}" Click="ShowDataManagement_Click" />
                </StackPanel>
            </Grid>
        </Border>
                <Border x:Name="MonitoringStatusCard"  Background="Transparent"
                        BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,0,0,1"
                        Grid.Row="1" Padding="32,8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="MonitoringStateIndicator" Width="8" Height="8"
                                     Style="{StaticResource MonitoringStateIndicatorStyle}"
                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="MonitoringStateText"
                                       Text="{Binding MonitoringStateDisplay, Mode=OneWay}"
                                       Foreground="{Binding ElementName=MonitoringStateIndicator, Path=Fill}"
                                       FontSize="12" FontWeight="SemiBold" />
