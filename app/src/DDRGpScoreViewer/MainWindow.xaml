                           Text="今日のプレー状況と最近の記録を確認できます"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1"
                    Margin="0,16,0,12"
                    Padding="12,10"
                    Background="{DynamicResource NotificationWarningBackgroundBrush}"
                    BorderBrush="{DynamicResource NotificationWarningBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding UnresolvedNotificationVisibility}">
                <StackPanel>
                    <TextBlock Text="{Binding UnresolvedNotificationTitle}"
                               Foreground="{DynamicResource NotificationWarningTitleBrush}"
                               FontWeight="SemiBold"
                               FontSize="13" />
                    <TextBlock Text="{Binding UnresolvedNotificationMessage}"
                               Foreground="{DynamicResource NotificationWarningTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <controls:StatePanel Grid.Row="2" Visibility="{Binding StatusVisibility}"
                                 Title="{Binding StatusTitle}" Message="{Binding StatusMessage}" />

            <TabControl x:Name="ContentTabs" Grid.Row="2" Visibility="{Binding DataVisibility}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Background="Transparent" BorderThickness="0" SelectedIndex="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                    </Style>
                </TabControl.Resources>
                <TabItem>
                    <ScrollViewer x:Name="HomeScrollViewer" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid x:Name="HomeTopGrid" Margin="0,0,16,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border x:Name="HomeLatestPlayCard" Margin="0,0,16,0" Padding="0"
                                        Style="{StaticResource CardStyle}" Background="{DynamicResource HeroBackgroundBrush}">
                                    <Grid>
                                        <Border x:Name="HomeLatestDifficultyStripe" DataContext="{Binding HomeLatestPlay}">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource DifficultyStripeStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <TextBlock Text="{DynamicResource まだプレーの記録がありません。ゲームのリザルト画面から自動で記録します。}"
                                                   TextWrapping="Wrap" Margin="16" FontSize="16" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HomeLatestPlay}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel x:Name="HomeLatestPlayBody" Margin="16,12" DataContext="{Binding HomeLatestPlay}">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <DockPanel LastChildFill="True">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <Border Style="{StaticResource ClearBadgeStyle}" Tag="{Binding ClearBadgeGroup}" Margin="0,0,6,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Tag="{Binding ClearBadgeGroup}" Margin="0,0,5,0">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse" BasedOn="{StaticResource ClearLampStyle}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasClear}" Value="False">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                            <TextBlock Text="{Binding ClearDisplay}" Style="{StaticResource BadgeTextStyle}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Tag="{Binding FlareBadgeGroup}" Style="{StaticResource FlareBadgeStyle}">
                                                        <TextBlock Text="{Binding FlareRankDisplay}" Style="{StaticResource BadgeTextStyle}" />
                                                    </Border>
                                                </StackPanel>
                                                <WrapPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource 最後に記録したプレー}" FontWeight="SemiBold"
                                                               Style="{StaticResource ScorebookCaptionStyle}" />
                                                    <TextBlock Text="{Binding LatestPlayedAtDisplay}" Margin="8,0,0,0"
                                                               Style="{StaticResource ScorebookCaptionStyle}" />
                                                </WrapPanel>
                                            </DockPanel>
                                            <TextBlock x:Name="HomeLatestSongTitle" Text="{Binding SongTitle}" TextWrapping="Wrap"
                                                       FontSize="32" FontWeight="SemiBold" Margin="0,4,0,3"
                                                       LineHeight="36" LineStackingStrategy="BlockLineHeight" />
                                            <StackPanel Orientation="Horizontal">
                                                <Border Style="{StaticResource DifficultyBadgeStyle}">
                                                    <TextBlock Text="{Binding Difficulty}" Style="{StaticResource DifficultyBadgeTextStyle}" />
                                                </Border>
                                                <TextBlock Text="{Binding PlayStyleDisplay}" Margin="8,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding LevelDisplay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <WrapPanel x:Name="HomeLatestScoreAndDelta" Margin="0,3,0,0">
                                                <StackPanel x:Name="HomeLatestScorePanel" VerticalAlignment="Bottom">
                                                    <WrapPanel Margin="0,-3,0,0">
                                                        <TextBlock x:Name="HomeLatestScore" Text="{Binding ScoreDisplay}" Style="{StaticResource ScorebookNumberStyle}"
                                                                   Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="60"
                                                                   LineHeight="65" LineStackingStrategy="BlockLineHeight" />
                                                        <TextBlock Text="{Binding RankDisplay}" Tag="{Binding RankBadgeGroup}"
                                                                   Style="{StaticResource InlineRankStyle}" FontSize="26"
                                                                   VerticalAlignment="Bottom" Margin="12,0,0,12" />
                                                    </WrapPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,-5,0,0">
                                                        <TextBlock Text="EX SCORE" Style="{StaticResource ScorebookCaptionStyle}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding ExScoreDisplay}" Style="{StaticResource ScorebookNumberStyle}"
                                                                   FontSize="16" Margin="8,0,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel x:Name="HomeLatestDeltaPanel" VerticalAlignment="Bottom" Margin="12,0,0,0">
                                                    <TextBlock Text="{DynamicResource プレー前の自己ベストとの差}"
                                                               Style="{StaticResource ScorebookCaptionStyle}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                                    <WrapPanel>
                                                        <Border Style="{StaticResource HomeDeltaChipStyle}" Tag="{Binding ScoreBestDeltaGroup}" Margin="0,0,8,4">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="SCORE" Style="{StaticResource ScorebookCaptionStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                <TextBlock Text="{Binding ScoreBestDeltaDisplay}" Style="{StaticResource HomeLatestDeltaTextStyle}" Tag="{Binding ScoreBestDeltaGroup}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Style="{StaticResource HomeDeltaChipStyle}" Tag="{Binding ExScoreBestDeltaGroup}" Margin="0,0,0,4">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="EX SCORE" Style="{StaticResource ScorebookCaptionStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                <TextBlock Text="{Binding ExScoreBestDeltaDisplay}" Style="{StaticResource HomeLatestDeltaTextStyle}" Tag="{Binding ExScoreBestDeltaGroup}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </WrapPanel>

                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="99*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar x:Name="HomeScoreGauge" Grid.ColumnSpan="2" Height="7"
                                                             Minimum="0" Maximum="1000000" Value="{Binding Play.Score, Mode=OneWay}"
                                                             Foreground="{DynamicResource AccentPrimaryBrush}"
                                                             Background="{DynamicResource SurfaceSecondaryBrush}"
                                                             AutomationProperties.Name="{Binding AaaTargetDisplay}">
                                                    <ProgressBar.Template>
                                                        <ControlTemplate TargetType="ProgressBar">
                                                            <Grid>
                                                                <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3" />
                                                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left" />
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </ProgressBar.Template>
                                                </ProgressBar>
                                                <Border Grid.Column="1" Width="2" Height="13" HorizontalAlignment="Left"
                                                        Background="{DynamicResource RankUpperTextBrush}" ToolTip="AAA 990,000" />
                                            </Grid>
                                            <DockPanel Margin="0,2,0,0">
                                                <TextBlock DockPanel.Dock="Left" Text="0" Style="{StaticResource ScorebookCaptionStyle}" />
                                                <TextBlock DockPanel.Dock="Right" Text="1,000,000" Style="{StaticResource ScorebookCaptionStyle}" />
                                                <TextBlock Text="{Binding AaaTargetDisplay}" Style="{StaticResource ScorebookCaptionStyle}"
                                                           Foreground="{DynamicResource RankUpperTextBrush}" TextAlignment="Center"
                                                           FontWeight="SemiBold" TextWrapping="Wrap" Margin="8,0" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border x:Name="HomeTodayCard" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <WrapPanel>
                                                <TextBlock Text="{DynamicResource 今日のプレー}" Style="{StaticResource ScorebookSectionTitleStyle}" FontSize="16" />
                                                <TextBlock Text="{Binding HomeTodayDateDisplay}" Style="{StaticResource ScorebookCaptionStyle}"
                                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </WrapPanel>
                                            <TextBlock Text="{DynamicResource 毎朝7時に切り替わります}" TextWrapping="Wrap"
                                                       Style="{StaticResource ScorebookCaptionStyle}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel x:Name="HomeTodayMetrics" Grid.Row="1" VerticalAlignment="Center" Margin="0,8">
                                            <Border Style="{StaticResource HomeTodayMetricStyle}" Margin="{DynamicResource HomeMetricRowGap}">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding HomeTodayPlayCount, StringFormat=N0}" Style="{StaticResource HomeTodayValueStyle}" />
                                                    <TextBlock Text="{DynamicResource プレー数}" Style="{StaticResource HomeTodayMetricLabelStyle}" />
                                                </DockPanel>
                                            </Border>
                                            <Border Style="{StaticResource HomeTodayMetricStyle}" Margin="{DynamicResource HomeMetricRowGap}">
                                                <DockPanel>
                                                    <TextBlock x:Name="HomeTodayNotesValue" DockPanel.Dock="Right"
                                                               Text="{Binding HomeTodayTotalNotesDisplay}" Style="{StaticResource HomeTodayValueStyle}" />
                                                    <TextBlock Text="{DynamicResource 総ノーツ数}" Style="{StaticResource HomeTodayMetricLabelStyle}" />
                                                </DockPanel>
                                            </Border>
                                            <Border Style="{StaticResource HomeTodayMetricStyle}">
                                                <DockPanel>
                                                    <TextBlock x:Name="HomeTodayCaloriesValue" DockPanel.Dock="Right"
                                                               Text="{Binding HomeTodayCaloriesGroupedDisplay}" Style="{StaticResource HomeTodayValueStyle}" />
                                                    <TextBlock Text="{DynamicResource 消費カロリー}" Style="{StaticResource HomeTodayMetricLabelStyle}" />
                                                </DockPanel>
                                            </Border>
                                        </StackPanel>
                                        <Button x:Name="HomeSummaryCopyButton" Grid.Row="2" Content="{DynamicResource 今日の記録をコピー}"
                                                TabIndex="100" Style="{StaticResource PrimaryButtonStyle}" MinHeight="32" Padding="12,5"
                                                ContentTemplate="{StaticResource BoundButtonLabelTemplate}"
                                                Click="CopyHomeSummary_Click" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid x:Name="HomeListsGrid" Margin="0,0,16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border x:Name="HomeHistoryCard" Margin="0,0,16,0" Style="{StaticResource CardStyle}" Padding="16,8">
                                    <StackPanel x:Name="HomeHistoryPanel">
                                        <DockPanel Margin="0,0,0,5">
                                            <Button DockPanel.Dock="Right" Content="{DynamicResource 履歴を見る}" Margin="8,0,0,0"
                                                    Style="{StaticResource HomeSectionLinkStyle}" Click="ShowHistory_Click" TabIndex="101" />
                                            <TextBlock Text="{DynamicResource 最近のプレー}" Style="{StaticResource ScorebookSectionTitleStyle}" FontSize="16" TextWrapping="Wrap" />
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding HomeRecentPlays}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource HomeFeedRowStyle}" Click="HomeRecentPlay_Click" TabIndex="102" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="HomeUpdatesCard" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16,8">
                                    <StackPanel x:Name="HomeUpdatesPanel">
                                        <DockPanel Margin="0,0,0,5">
                                            <Button DockPanel.Dock="Right" Content="{DynamicResource 自己ベストを見る}" Margin="8,0,0,0"
                                                    Style="{StaticResource HomeSectionLinkStyle}" Click="ShowBest_Click" TabIndex="103" />
                                            <TextBlock Text="{DynamicResource 最近の自己ベスト更新}" Style="{StaticResource ScorebookSectionTitleStyle}" FontSize="16" TextWrapping="Wrap" />
                                        </DockPanel>
                                        <TextBlock Text="{DynamicResource 自己ベスト更新はまだありません}" TextWrapping="Wrap" Margin="0,10">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource ScorebookCaptionStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasHomeBestUpdates}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding HomeBestUpdates}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource HomeFeedRowStyle}" Click="HomeBestUpdate_Click"
                                                            TabIndex="104" Tag="BestUpdate" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem>
                    <Grid x:Name="BestLayoutGrid" MinWidth="0" MinHeight="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="232" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border x:Name="BestConditionsPanel" Grid.RowSpan="4" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,0,1,0" Padding="0,0,20,0" Margin="0,0,24,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <WrapPanel x:Name="BestConditionHeader">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <Button x:Name="BestSingleButton" MinWidth="0" Width="92" Padding="4,8" FontSize="12" Content="SINGLE (SP)" Style="{StaticResource BestSegmentButtonStyle}" TabIndex="100" Click="BestPlayStyle_Click" />
                                            <Button x:Name="BestDoubleButton" MinWidth="0" Width="92" Padding="4,8" FontSize="12" Content="DOUBLE (DP)" Style="{StaticResource BestSegmentButtonStyle}" TabIndex="101" Click="BestPlayStyle_Click" />
                                        </StackPanel>
                                        <WrapPanel x:Name="BestModeButtons" Margin="0,0,0,12">
                                            <Button x:Name="BestLevelModeButton" MinWidth="0" Width="88" Margin="0,0,4,4" Padding="2,8" FontSize="12" Content="レベルから" Style="{StaticResource BestBrowseTabButtonStyle}" TabIndex="102" Click="BestBrowseMode_Click" />
                                            <Button x:Name="BestVersionModeButton" MinWidth="0" Width="88" Margin="0,0,4,4" Padding="2,8" FontSize="12" Content="バージョンから" Style="{StaticResource BestBrowseTabButtonStyle}" TabIndex="103" Click="BestBrowseMode_Click" />
                                            <Button x:Name="BestTitleModeButton" MinWidth="0" Width="88" Margin="0,0,4,4" Padding="2,8" FontSize="12" Content="曲名から" Style="{StaticResource BestBrowseTabButtonStyle}" TabIndex="104" Click="BestBrowseMode_Click" />
                                            <Button x:Name="BestGoalModeButton" MinWidth="0" Width="88" Margin="0,0,4,4" Padding="2,8" FontSize="12" Content="目標から" Style="{StaticResource BestBrowseTabButtonStyle}" TabIndex="105" Click="BestBrowseMode_Click" />
                                        </WrapPanel>
                                    </WrapPanel>
                                    <StackPanel x:Name="BestAxisPanel">
                                        <StackPanel x:Name="BestTitleSearchPanel" Visibility="Collapsed">
                                            <TextBlock Text="曲名の一部" Style="{StaticResource ScorebookCaptionStyle}" Margin="0,0,0,6" />
                                            <TextBox x:Name="BestTitleSearchTextBox" Text="{Binding BestSongQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BestTitleSearchTextBoxStyle}" TabIndex="107" ToolTip="曲名の一部で検索" />
                                        </StackPanel>
                                        <StackPanel x:Name="BestLevelOptionsPanel">
                                            <TextBlock Text="レベル" Style="{StaticResource ScorebookCaptionStyle}" Margin="0,0,0,8" />
                                            <ComboBox x:Name="BestLevelComboBox" ItemsSource="{Binding BestLevelOptions}" DisplayMemberPath="Display" SelectedValuePath="Code" SelectedValue="{Binding BestLevelFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="160" TabIndex="107" />
                                            <ListBox x:Name="BestLevelOptionsGrid" ItemsSource="{Binding BestLevelOptions}" SelectedValuePath="Code" SelectedValue="{Binding BestLevelFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" TabIndex="107">
                                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource BestAxisOptionStyle}"><Setter Property="Width" Value="40" /><Setter Property="Padding" Value="2,6" /><Setter Property="FontSize" Value="11" /></Style></ListBox.ItemContainerStyle><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap" /></DataTemplate></ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                        <StackPanel x:Name="BestVersionOptionsPanel">
                                            <TextBlock Text="バージョン" Style="{StaticResource ScorebookCaptionStyle}" Margin="0,0,0,8" />
                                            <ComboBox x:Name="BestVersionComboBox" ItemsSource="{Binding BestVersionOptions}" DisplayMemberPath="Display" SelectedValuePath="Code" SelectedValue="{Binding BestVersionFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="160" TabIndex="107" />
                                            <ListBox x:Name="BestVersionOptionsGrid" ItemsSource="{Binding BestVersionOptions}" SelectedValuePath="Code" SelectedValue="{Binding BestVersionFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" TabIndex="107">
                                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource BestAxisOptionStyle}"><Setter Property="Width" Value="88" /><Setter Property="MinHeight" Value="28" /><Setter Property="Padding" Value="2,4" /><Setter Property="FontSize" Value="11" /><Setter Property="Margin" Value="0,0,4,4" /></Style></ListBox.ItemContainerStyle><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap" /></DataTemplate></ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                        <StackPanel x:Name="BestGoalOptionsPanel">
                                            <TextBlock Text="目標" Style="{StaticResource ScorebookCaptionStyle}" Margin="0,0,0,8" />
                                            <ComboBox x:Name="BestGoalComboBox" ItemsSource="{Binding BestGoalOptions}" DisplayMemberPath="Display" SelectedValuePath="Code" SelectedValue="{Binding BestGoalFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="160" TabIndex="107" />
                                            <ListBox x:Name="BestGoalOptionsGrid" ItemsSource="{Binding BestGoalOptions}" SelectedValuePath="Code" SelectedValue="{Binding BestGoalFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ItemContainerStyle="{StaticResource BestAxisOptionStyle}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" TabIndex="107">
                                                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap" /></DataTemplate></ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border x:Name="BestProgressCard" Grid.Column="1" Grid.Row="1" Style="{StaticResource CardStyle}" Background="{DynamicResource SurfaceSecondaryBrush}" Padding="16,8"
                                Margin="0,0,0,4"
                                Visibility="{Binding BestProgressVisibility, Mode=OneWay}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="{Binding BestProgressTitle, Mode=OneWay}"
                                           FontSize="13" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                                <UniformGrid x:Name="BestProgressMetrics" Grid.Row="1" Margin="0,8,0,6" Columns="6">
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="対象譜面" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="12" />
                                        <TextBlock Text="{Binding BestProgressTargetCount, Mode=OneWay}"
                                                   FontSize="15" FontWeight="Bold" FontFamily="Segoe UI Variable, Segoe UI" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="記録あり" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="12" />
                                        <TextBlock Text="{Binding BestProgressRecordedCount, Mode=OneWay}"
                                                   FontSize="15" FontWeight="Bold" FontFamily="Segoe UI Variable, Segoe UI" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="記録なし" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="12" />
                                        <TextBlock Text="{Binding BestProgressUnrecordedCount, Mode=OneWay}"
                                                   FontSize="15" FontWeight="Bold" FontFamily="Segoe UI Variable, Segoe UI" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="CLEAR以上" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="12" />
                                        <TextBlock Text="{Binding BestProgressClearCount, Mode=OneWay}"
                                                   FontSize="15" FontWeight="Bold" FontFamily="Segoe UI Variable, Segoe UI" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="FC以上" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="12" />
                                        <TextBlock Text="{Binding BestProgressFullComboCount, Mode=OneWay}"
                                                   FontSize="15" FontWeight="Bold" FontFamily="Segoe UI Variable, Segoe UI" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="AAA以上" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="12" />
                                        <TextBlock Text="{Binding BestProgressAaaCount, Mode=OneWay}"
                                                   FontSize="15" FontWeight="Bold" FontFamily="Segoe UI Variable, Segoe UI" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <Grid x:Name="BestResultSummary" Grid.Column="1" Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ChartBestRangeDisplay}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Bottom" />
                            <StackPanel x:Name="BestResultActions" Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding BestSortVisibility, Mode=OneWay}">
                                <TextBlock Text="並び順" Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox x:Name="BestSortComboBox" TabIndex="108"
                                          ItemsSource="{Binding BestSortOptions}"
