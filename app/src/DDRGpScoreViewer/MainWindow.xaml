<Window x:Class="DDRGpScoreViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DDRGpScoreViewer.Controls"
        Title="GP Score Log" Icon="Assets/GPScoreLog.ico" Width="1280" Height="760"
        MinWidth="960" MinHeight="640" WindowStartupLocation="CenterScreen"
        SizeChanged="MainWindow_SizeChanged">
    <Window.Resources>
        <DataTemplate x:Key="FlareBadgeOrPlaceholderTemplate">
            <Grid>
                <Border x:Name="FlareBadge" Style="{StaticResource FlareBadgeStyle}"
                        Tag="{Binding FlareBadgeGroup, Mode=OneWay}">
                    <TextBlock Text="{Binding FlareRankDisplay, Mode=OneWay}"
                               Style="{StaticResource BadgeTextStyle}" />
                </Border>
                <TextBlock x:Name="FlarePlaceholder" Text="—" Visibility="Collapsed"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" VerticalAlignment="Center" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding FlareBadgeGroup}" Value="None">
                    <Setter TargetName="FlareBadge" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="FlarePlaceholder" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="RankBadgeOrPlaceholderTemplate">
            <Grid>
                <Border x:Name="RankBadge" Style="{StaticResource RankBadgeStyle}"
                        Tag="{Binding RankBadgeGroup, Mode=OneWay}">
                    <TextBlock Text="{Binding RankDisplay, Mode=OneWay}"
                               Style="{StaticResource BadgeTextStyle}" />
                </Border>
                <TextBlock x:Name="RankPlaceholder" Text="—" Visibility="Collapsed"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" VerticalAlignment="Center" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasRank, Mode=OneWay}" Value="False">
                    <Setter TargetName="RankBadge" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="RankPlaceholder" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ClearBadgeOrPlaceholderTemplate">
            <Grid>
                <Border x:Name="ClearBadge" Style="{StaticResource ClearBadgeStyle}"
                        Tag="{Binding ClearBadgeGroup, Mode=OneWay}">
                    <TextBlock Text="{Binding ClearDisplay, Mode=OneWay}"
                               Style="{StaticResource BadgeTextStyle}" />
                </Border>
                <TextBlock x:Name="ClearPlaceholder" Text="—" Visibility="Collapsed"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" VerticalAlignment="Center" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasClear, Mode=OneWay}" Value="False">
                    <Setter TargetName="ClearBadge" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ClearPlaceholder" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="HomeSectionLinkStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HomeSummaryCardStyle" TargetType="Border"
               BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="14,14" />
            <Setter Property="MinHeight" Value="100" />
        </Style>

        <Style x:Key="HomeDeltaChipStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Up">
                    <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource AccentPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Down">
                    <Setter Property="Background" Value="#FEF2F2" />
                    <Setter Property="BorderBrush" Value="#FECACA" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="First">
                    <Setter Property="Background" Value="#DBEAFE" />
                    <Setter Property="BorderBrush" Value="#93C5FD" />
                    <Setter Property="TextElement.Foreground" Value="#1D4ED8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HomeDeltaTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Up">
                    <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Down">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="First">
                    <Setter Property="Foreground" Value="#1D4ED8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BestStyleButtonStyle" TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Padding" Value="14,6" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="Selected">
                    <Setter Property="Background" Value="White" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsSinglePlayStyleButtonStyle" TargetType="Button"
               BasedOn="{StaticResource BestStyleButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DefaultPlayStyle}" Value="SINGLE">
                    <Setter Property="Tag" Value="Selected" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsDoublePlayStyleButtonStyle" TargetType="Button"
               BasedOn="{StaticResource BestStyleButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DefaultPlayStyle}" Value="DOUBLE">
                    <Setter Property="Tag" Value="Selected" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid MinWidth="0" MinHeight="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn" Width="230" />
            <ColumnDefinition Width="*" MinWidth="0" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource BackgroundSidebarBrush}">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Bottom" Background="#1E293B"
                        BorderBrush="#334155" BorderThickness="1" CornerRadius="10"
                        Padding="14" Margin="12,0,12,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#38BDF8"
                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="自動記録：待機中" Foreground="#38BDF8"
                                       FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="DDR GP ウィンドウ待機中" Foreground="#94A3B8"
                                   FontSize="11" Margin="0,6,0,0" />
                        <Button Content="監視を開始する"
                                IsEnabled="{Binding CanStartMonitoring}"
                                Click="StartContinuousCaptureAndSave_Click"
                                Margin="0,12,0,0">
                            <Button.Style>
                                <Style BasedOn="{StaticResource PrimaryButtonStyle}" TargetType="Button">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanStopMonitoring}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="監視を停止する"
                                IsEnabled="{Binding CanStopMonitoring}"
                                Click="StopContinuousCapture_Click"
                                Margin="0,12,0,0">
                            <Button.Style>
                                <Style BasedOn="{StaticResource PrimaryButtonStyle}" TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanStopMonitoring}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
                <StackPanel>
                    <Border BorderBrush="#263A56" BorderThickness="0,0,0,1"
                            Padding="20,20,20,20">
                        <StackPanel>
                            <TextBlock Text="GP Score Log" Foreground="White"
                                       FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="DDR GRAND PRIX Score Tracker" Foreground="#94A3B8"
                                       FontSize="11" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="HomeNavigation" Content="ホーム" Tag="Selected"
                            Style="{StaticResource SidebarButtonStyle}" Click="ShowHome_Click" />
                    <Button x:Name="BestNavigation" Content="自己ベスト"
                            Style="{StaticResource SidebarButtonStyle}" Click="ShowBest_Click" />
                    <Button x:Name="HistoryNavigation" Content="直近プレー履歴"
                            Style="{StaticResource SidebarButtonStyle}" Click="ShowHistory_Click" />
                    <Separator Margin="16,10" Background="#50627B" />
                    <Button x:Name="SettingsNavigation" Content="設定"
                            Style="{StaticResource SidebarButtonStyle}" Click="ShowSettings_Click" />
                    <Button x:Name="DataManagementNavigation" Content="データ管理"
                            Style="{StaticResource SidebarButtonStyle}" Click="ShowDataManagement_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid x:Name="MainContentGrid" Grid.Column="1" Margin="28,24" MinWidth="0" MinHeight="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" MinHeight="20" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Debug build actions remain available to the existing debug workflow, but are not part of the user-facing mock layout. -->
            <DockPanel x:Name="ActionBar" Visibility="Collapsed" />
            <StackPanel Grid.Row="0">
                <TextBlock x:Name="PageTitle" Text="ホーム" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="PageSubtitle"
                           Text="今日のプレー状況と最近の記録を確認できます"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" Margin="0,4,0,0" />
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,16,0,12"
                    Padding="12,10"
                    Background="#FFF7ED"
                    BorderBrush="#FDBA74"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding UnresolvedNotificationVisibility}">
                <StackPanel>
                    <TextBlock Text="{Binding UnresolvedNotificationTitle}"
                               Foreground="#9A3412"
                               FontWeight="SemiBold"
                               FontSize="13" />
                    <TextBlock Text="{Binding UnresolvedNotificationMessage}"
                               Foreground="#7C2D12"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <controls:StatePanel Grid.Row="2" Visibility="{Binding StatusVisibility}"
                                 Title="{Binding StatusTitle}" Message="{Binding StatusMessage}" />

            <TabControl x:Name="ContentTabs" Grid.Row="2" Visibility="{Binding DataVisibility}"
                        Background="Transparent" BorderThickness="0" SelectedIndex="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed" /></Style>
                </TabControl.Resources>
                <TabItem>
                    <ScrollViewer x:Name="HomeScrollViewer"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="0,0,8,0">
                        <StackPanel MinWidth="0">
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="今日のプレー状況" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11" Margin="0,3,0,8">
                                    <Run Text="{Binding HomeTodayDateDisplay, Mode=OneWay}" />
                                    <Run Text=" の保存済みプレーデータ" />
                                </TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource HomeSummaryCardStyle}"
                                            BorderBrush="{StaticResource AccentPrimaryBrush}"
                                            BorderThickness="4,1,1,1" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="プレー数" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding HomeTodayPlayCount, Mode=OneWay, StringFormat={}{0:N0}}"
                                                       FontSize="26" FontWeight="Bold" FontFamily="Consolas"
                                                       Margin="0,5,0,0" />
                                            <TextBlock Text="今日保存されたプレー" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="10" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource HomeSummaryCardStyle}"
                                            BorderBrush="#10B981" BorderThickness="4,1,1,1" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="自己ベスト更新" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11" FontWeight="SemiBold" />
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding HomeTodayScoreUpdateCount, Mode=OneWay, StringFormat={}{0:N0}}"
                                                               FontSize="24" FontWeight="Bold" FontFamily="Consolas" />
                                                    <TextBlock Text="通常" Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="10" FontWeight="SemiBold" Margin="5,0,0,0" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                            Margin="18,0,0,0">
                                                    <TextBlock Text="{Binding HomeTodayExScoreUpdateCount, Mode=OneWay, StringFormat={}{0:N0}}"
                                                               FontSize="24" FontWeight="Bold" FontFamily="Consolas" />
                                                    <TextBlock Text="EX" Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="10" FontWeight="SemiBold" Margin="5,0,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="今日の更新プレー" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="10" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource HomeSummaryCardStyle}"
                                            BorderBrush="#FACC15" BorderThickness="4,1,1,1">
                                        <StackPanel>
                                            <TextBlock Text="フルコンボ数" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding HomeTodayFullComboCount, Mode=OneWay, StringFormat={}{0:N0}}"
                                                       FontSize="26" FontWeight="Bold" FontFamily="Consolas"
                                                       Margin="0,5,0,0" />
                                            <TextBlock Text="FC以上の記録" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="10" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="16,12,16,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="プレー履歴" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="最新のプレーと直近5件"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="履歴を見る"
                                                Style="{StaticResource HomeSectionLinkStyle}"
                                                Click="ShowHistory_Click" />
                                    </Grid>

                                    <Border x:Name="HomeLatestPlayCard" Background="{StaticResource SurfaceSecondaryBrush}"
                                            BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="0,1,0,1"
                                            Padding="16"
                                            DataContext="{Binding DataContext.HomeLatestPlay,
                                                RelativeSource={RelativeSource AncestorType={x:Type Window}},
                                                Mode=OneWay}">
                                        <StackPanel MinWidth="0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{StaticResource AccentSubtleBrush}"
                                                        BorderBrush="#93C5FD" BorderThickness="1"
                                                        CornerRadius="6" Padding="9,4"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="最新" Foreground="#1D4ED8"
                                                               FontSize="11" FontWeight="Bold" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding LatestPlayedAtDisplay, Mode=OneWay}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="11" HorizontalAlignment="Right" />
                                            </Grid>
                                            <TextBlock Text="{Binding SongTitle, Mode=OneWay}" FontSize="19" FontWeight="Bold"
                                                       TextWrapping="Wrap" TextTrimming="None" Margin="0,12,0,0" />
                                            <Grid x:Name="LatestFeaturedBody" Margin="0,12,0,0" MinWidth="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.55*" MinWidth="0" />
                                                    <ColumnDefinition Width="1*" MinWidth="250" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel x:Name="LatestMain" Grid.Row="0" Grid.Column="0"
                                                            MinWidth="0" Margin="0,0,24,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Style="{StaticResource DifficultyBadgeStyle}">
                                                            <TextBlock Text="{Binding Difficulty, Mode=OneWay}"
                                                                       Style="{StaticResource DifficultyBadgeTextStyle}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding PlayStyleDisplay, Mode=OneWay}" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        <TextBlock Text=" / " Foreground="{StaticResource TextSecondaryBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding LevelDisplay, Mode=OneWay}" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ScoreDisplay, Mode=OneWay}" FontSize="30" FontWeight="Bold"
                                                                   FontFamily="Consolas" />
                                                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="12" FontWeight="SemiBold" Margin="14,0,0,0">
                                                            <Run Text="EX SCORE " />
                                                            <Run Text="{Binding ExScoreDisplay, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <WrapPanel Margin="0,10,0,0" ItemHeight="27">
                                                        <ContentControl Content="{Binding}"
                                                                        ContentTemplate="{StaticResource RankBadgeOrPlaceholderTemplate}"
                                                                        Margin="0,0,6,4"
                                                                        HorizontalContentAlignment="Left"
                                                                        VerticalContentAlignment="Center" />
                                                        <ContentControl Content="{Binding}"
                                                                        ContentTemplate="{StaticResource ClearBadgeOrPlaceholderTemplate}"
                                                                        Margin="0,0,6,4"
                                                                        HorizontalContentAlignment="Left"
                                                                        VerticalContentAlignment="Center" />
                                                        <ContentControl Content="{Binding}"
                                                                        ContentTemplate="{StaticResource FlareBadgeOrPlaceholderTemplate}"
                                                                        Margin="0,0,6,4"
                                                                        HorizontalContentAlignment="Left"
                                                                        VerticalContentAlignment="Center" />
                                                        <StackPanel Orientation="Horizontal" Margin="3,0,0,4"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding PreviousScoreDisplay, Mode=OneWay}"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="10" />
                                                            <TextBlock Text="{Binding PreviousExScoreDisplay, Mode=OneWay}"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="10" Margin="9,0,0,0" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                </StackPanel>
                                                <Border x:Name="LatestInfoBorder" Grid.Row="0" Grid.Column="1"
                                                        BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1,0,0,0"
                                                        Padding="18,0,0,0" MinWidth="0">
                                                    <StackPanel>
                                                        <StackPanel Margin="0,0,0,10">
                                                            <TextBlock Text="通常スコア自己ベスト差"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="11" FontWeight="SemiBold" />
                                                            <Border Style="{StaticResource HomeDeltaChipStyle}"
                                                                    Tag="{Binding ScoreBestDeltaGroup, Mode=OneWay}" Margin="0,3,0,0">
                                                                <TextBlock Text="{Binding ScoreBestDeltaDisplay, Mode=OneWay}"
                                                                           Style="{StaticResource HomeDeltaTextStyle}"
                                                                           Tag="{Binding ScoreBestDeltaGroup, Mode=OneWay}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock Text="EXスコア自己ベスト差"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="11" FontWeight="SemiBold" />
                                                            <Border Style="{StaticResource HomeDeltaChipStyle}"
                                                                    Tag="{Binding ExScoreBestDeltaGroup, Mode=OneWay}" Margin="0,3,0,0">
                                                                <TextBlock Text="{Binding ExScoreBestDeltaDisplay, Mode=OneWay}"
                                                                           Style="{StaticResource HomeDeltaTextStyle}"
                                                                           Tag="{Binding ExScoreBestDeltaGroup, Mode=OneWay}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding HomeRecentPlays}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="0,0,0,1"
                                                        Padding="12,12" MinWidth="0">
                                                    <Grid MinWidth="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="92" />
                                                            <ColumnDefinition Width="*" MinWidth="0" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                         <TextBlock Text="{Binding HomePlayedAtDisplay, Mode=OneWay}"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="11" VerticalAlignment="Top" />
                                                        <StackPanel Grid.Column="1" MinWidth="0">
                                                            <TextBlock Text="{Binding SongTitle, Mode=OneWay}" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                <Border Style="{StaticResource DifficultyBadgeStyle}">
                                                                    <TextBlock Text="{Binding ChartDisplay, Mode=OneWay}"
                                                                               Style="{StaticResource DifficultyBadgeTextStyle}" />
                                                                </Border>
                                                                <TextBlock Text="{Binding LevelDisplay, Mode=OneWay}"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           FontSize="11" Margin="10,0,0,0"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                <TextBlock Text="{Binding ScoreDisplay, Mode=OneWay}" FontFamily="Consolas"
                                                                           FontSize="12" FontWeight="Bold" />
                                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                                                           FontSize="11" Margin="10,0,0,0">
                                                                    <Run Text="EX " /><Run Text="{Binding ExScoreDisplay, Mode=OneWay}" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center" Margin="12,0,0,0">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                <ContentControl Content="{Binding}"
                                                                                ContentTemplate="{StaticResource RankBadgeOrPlaceholderTemplate}"
                                                                                Margin="0,0,5,0"
                                                                                HorizontalContentAlignment="Left"
                                                                                VerticalContentAlignment="Center" />
                                                                <ContentControl Content="{Binding}"
                                                                                ContentTemplate="{StaticResource ClearBadgeOrPlaceholderTemplate}"
                                                                                Margin="0,0,5,0"
                                                                                HorizontalContentAlignment="Left"
                                                                                VerticalContentAlignment="Center" />
                                                                <ContentControl Content="{Binding}"
                                                                                ContentTemplate="{StaticResource FlareBadgeOrPlaceholderTemplate}"
                                                                                HorizontalContentAlignment="Left"
                                                                                VerticalContentAlignment="Center" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                                        Margin="0,5,0,0">
                                                                <TextBlock Tag="{Binding ScoreBestDeltaGroup, Mode=OneWay}"
                                                                           Style="{StaticResource HomeDeltaTextStyle}">
                                                                    <Run Text="SCORE " /><Run Text="{Binding ScoreBestDeltaDisplay, Mode=OneWay}" />
                                                                </TextBlock>
                                                                <TextBlock Tag="{Binding ExScoreBestDeltaGroup, Mode=OneWay}"
                                                                           Style="{StaticResource HomeDeltaTextStyle}" Margin="9,0,0,0">
                                                                    <Run Text="EX " /><Run Text="{Binding ExScoreBestDeltaDisplay, Mode=OneWay}" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Padding="0">
                                <StackPanel>
                                    <Grid Margin="16,12,16,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="最近の自己ベスト更新" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding HomeBestUpdateSummaryDisplay, Mode=OneWay}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="自己ベストを見る"
                                                Style="{StaticResource HomeSectionLinkStyle}"
                                                Click="ShowBest_Click" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding HomeBestUpdates}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="0,1,0,0"
                                                        Padding="12,12" MinWidth="0">
                                                    <Grid MinWidth="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="112" />
                                                            <ColumnDefinition Width="*" MinWidth="0" />
                                                            <ColumnDefinition Width="230" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding HomePlayedAtDisplay, Mode=OneWay}"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="11" VerticalAlignment="Top" />
                                                        <StackPanel Grid.Column="1" MinWidth="0">
                                                            <TextBlock Text="{Binding SongTitle, Mode=OneWay}" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                <Border Style="{StaticResource DifficultyBadgeStyle}">
                                                                    <TextBlock Text="{Binding ChartDisplay, Mode=OneWay}"
                                                                               Style="{StaticResource DifficultyBadgeTextStyle}" />
                                                                </Border>
                                                                <TextBlock Text="{Binding LevelDisplay, Mode=OneWay}"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           FontSize="11" Margin="10,0,0,0"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <Grid Grid.Column="2" Margin="16,0,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="通常SCORE" Foreground="{StaticResource TextSecondaryBrush}"
                                                                           FontSize="10" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding ScoreUpdateAmountDisplay, Mode=OneWay}"
                                                                           Foreground="{StaticResource AccentPrimaryBrush}"
                                                                           FontSize="12" FontWeight="Bold" FontFamily="Consolas"
                                                                           Margin="0,3,0,0" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="EX SCORE" Foreground="{StaticResource TextSecondaryBrush}"
                                                                           FontSize="10" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding ExScoreUpdateAmountDisplay, Mode=OneWay}"
                                                                           Foreground="{StaticResource AccentPrimaryBrush}"
                                                                           FontSize="12" FontWeight="Bold" FontFamily="Consolas"
                                                                           Margin="0,3,0,0" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem>
                    <Grid MinWidth="0" MinHeight="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="260" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="12">
                            <StackPanel>
                                <WrapPanel>
                                    <StackPanel Orientation="Horizontal" Background="#F1F5F9"
                                                Margin="0,0,12,8">
                                        <Button x:Name="BestSingleButton" Content="SINGLE (SP)"
                                                Tag="Selected" Style="{StaticResource BestStyleButtonStyle}"
                                                Click="BestPlayStyle_Click" />
                                        <Button x:Name="BestDoubleButton" Content="DOUBLE (DP)"
                                                Tag="" Style="{StaticResource BestStyleButtonStyle}"
                                                Click="BestPlayStyle_Click" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="0,0,16,8">
                                        <TextBlock Text="難易度" Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox ItemsSource="{Binding BestDifficultyOptions}"
                                                  DisplayMemberPath="Display"
                                                  SelectedItem="{Binding SelectedBestDifficultyOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  MinWidth="110" MinHeight="30" Padding="8,3"
                                                  Background="White" BorderBrush="{StaticResource BorderStrongBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="0,0,16,8">
                                        <TextBlock Text="レベル" Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox ItemsSource="{Binding BestLevelOptions}"
                                                  DisplayMemberPath="Display"
                                                  SelectedItem="{Binding SelectedBestLevelOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  MinWidth="86" MinHeight="30" Padding="8,3"
                                                  Background="White" BorderBrush="{StaticResource BorderStrongBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="0,0,16,8">
                                        <TextBlock Text="曲名検索" Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Text="{Binding BestSongQuery, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="190" MinHeight="30" Padding="8,4"
                                                 Background="White" BorderBrush="{StaticResource BorderStrongBrush}"
                                                 ToolTip="曲名で絞り込み" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="0,0,0,8">
                                        <TextBlock Text="並び順" Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox ItemsSource="{Binding BestSortOptions}"
                                                  DisplayMemberPath="Display"
                                                  SelectedItem="{Binding SelectedBestSortOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  MinWidth="150" MinHeight="30" Padding="8,3"
                                                  Background="White" BorderBrush="{StaticResource BorderStrongBrush}" />
                                    </StackPanel>
                                </WrapPanel>

                                <Expander IsExpanded="True" Margin="0,2,0,0">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="詳細フィルター" Foreground="{StaticResource AccentPrimaryBrush}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="  " />
                                            <TextBlock Text="{Binding BestActiveFilterSummary}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Margin="0,8,0,0">
                                        <WrapPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                        Margin="0,0,16,8">
                                                <TextBlock Text="バージョン" Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <ComboBox ItemsSource="{Binding BestVersionOptions}"
                                                          DisplayMemberPath="Display"
                                                          SelectedItem="{Binding SelectedBestVersionOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          MinWidth="150" MinHeight="30" Padding="8,3"
                                                          Background="White" BorderBrush="{StaticResource BorderStrongBrush}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                        Margin="0,0,16,8">
                                                <TextBlock Text="プレー状況" Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <ComboBox ItemsSource="{Binding BestPlayStatusOptions}"
                                                          DisplayMemberPath="Display"
                                                          SelectedItem="{Binding SelectedBestPlayStatusOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          MinWidth="110" MinHeight="30" Padding="8,3"
                                                          Background="White" BorderBrush="{StaticResource BorderStrongBrush}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                        Margin="0,0,16,8">
                                                <TextBlock Text="ランク" Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <ComboBox ItemsSource="{Binding BestRankOptions}"
                                                          DisplayMemberPath="Display"
                                                          SelectedItem="{Binding SelectedBestRankOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          MinWidth="100" MinHeight="30" Padding="8,3"
                                                          Background="White" BorderBrush="{StaticResource BorderStrongBrush}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                        Margin="0,0,16,8">
                                                <TextBlock Text="CLEAR状態" Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <ComboBox ItemsSource="{Binding BestClearOptions}"
                                                          DisplayMemberPath="Display"
                                                          SelectedItem="{Binding SelectedBestClearOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          MinWidth="100" MinHeight="30" Padding="8,3"
                                                          Background="White" BorderBrush="{StaticResource BorderStrongBrush}" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <ItemsControl ItemsSource="{Binding BestActiveFilterChips}"
                                                      Margin="0,0,0,8">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource AccentSubtleBrush}"
                                                            BorderBrush="{StaticResource AccentPrimaryBrush}"
                                                            BorderThickness="1" CornerRadius="10"
                                                            Padding="8,3" Margin="0,0,6,4">
                                                        <TextBlock Text="{Binding}" FontSize="11"
                                                                   Foreground="{StaticResource AccentPrimaryBrush}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="フィルター・ソートを解除"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource HomeSectionLinkStyle}"
                                                Click="ResetBestFilters_Click" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1" Margin="0,12,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ChartBestRangeDisplay}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding ChartBestLoadMoreHintDisplay}"
                                       Foreground="{StaticResource AccentPrimaryBrush}" FontSize="11"
                                       TextWrapping="Wrap" TextAlignment="Right" />
                        </Grid>

                        <ItemsControl Grid.Row="2" ItemsSource="{Binding BestActiveFilterChips}"
                                      Visibility="Collapsed" />

                        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0">
                            <DataGrid x:Name="BestChartGrid" ItemsSource="{Binding ChartBests}"
                                      SelectedItem="{Binding SelectedChartBest, Mode=OneWay}"
                                      SelectionChanged="BestChartGrid_SelectionChanged"
                                      PreviewMouseLeftButtonDown="BestChartGrid_PreviewMouseLeftButtonDown"
                                      ScrollViewer.ScrollChanged="BestChartGrid_ScrollChanged"
                                      RowHeight="52" ColumnHeaderHeight="36"
                                      HeadersVisibility="Column"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      Style="{StaticResource ViewerDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="曲名" Binding="{Binding SongTitle, Mode=OneWay}"
                                                        Width="2.3*" />
                                    <DataGridTemplateColumn Header="譜面" Width="1.3*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <Border Style="{StaticResource DifficultyBadgeStyle}">
                                                        <Grid>
                                                            <TextBlock x:Name="FullDifficulty" Text="{Binding DifficultyDisplay, Mode=OneWay}"
                                                                       Style="{StaticResource DifficultyBadgeTextStyle}" />
                                                            <TextBlock x:Name="CompactDifficulty" Text="{Binding DifficultyShortDisplay, Mode=OneWay}"
                                                                       Style="{StaticResource DifficultyBadgeTextStyle}"
                                                                       Visibility="Collapsed" />
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="{Binding LevelDisplay, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="11" FontWeight="SemiBold" Margin="2,2,0,0" />
                                                </StackPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                                 Value="Compact">
                                                        <Setter TargetName="FullDifficulty" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="CompactDifficulty" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="SCORE / EX" Width="1.5*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding BestScoreDisplay, Mode=OneWay}" FontFamily="Consolas"
                                                               FontWeight="Bold" />
                                                    <TextBlock FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextSecondaryBrush}">
                                                        <Run Text="EX " /><Run Text="{Binding BestExScoreDisplay, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="RANK" Width="0.8*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl Content="{Binding}"
                                                                ContentTemplate="{StaticResource RankBadgeOrPlaceholderTemplate}"
                                                                HorizontalContentAlignment="Left"
                                                                VerticalContentAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="CLEAR" Width="0.95*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl Content="{Binding}"
                                                                ContentTemplate="{StaticResource ClearBadgeOrPlaceholderTemplate}"
                                                                HorizontalContentAlignment="Left"
                                                                VerticalContentAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="FLARE" Width="0.95*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl Content="{Binding}"
                                                                ContentTemplate="{StaticResource FlareBadgeOrPlaceholderTemplate}"
                                                                HorizontalContentAlignment="Left"
                                                                VerticalContentAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="プレー回数" Binding="{Binding PlayCountDisplay, Mode=OneWay}"
                                                        Width="1.05*" />
                                    <DataGridTextColumn Header="最終プレー" Binding="{Binding LastPlayedAtDisplay, Mode=OneWay}"
                                                        Width="1.25*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem x:Name="ChartDetailTab">
                    <ScrollViewer x:Name="ChartDetailScrollViewer"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="0,0,8,16">
                        <StackPanel MinWidth="0">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="自己ベスト / 楽曲・譜面詳細"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="自己ベストから選択した1譜面の記録とプレー推移を確認できます"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12" Margin="0,4,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="← 自己ベストに戻る"
                                        Style="{StaticResource HomeSectionLinkStyle}"
                                        Click="ShowBest_Click" Margin="12,0,0,0" />
                            </Grid>

                            <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,16">
                                <Grid MinWidth="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding ChartDetailSongTitle, Mode=OneWay}"
                                               FontSize="22" FontWeight="Bold"
                                               TextWrapping="Wrap" />
                                    <WrapPanel Grid.Row="1" Margin="0,7,0,0">
                                        <Border Style="{StaticResource DifficultyBadgeStyle}"
                                                DataContext="{Binding SelectedChartBest, Mode=OneWay}"
                                                Margin="0,0,8,0">
                                            <TextBlock Text="{Binding DifficultyDisplay, Mode=OneWay}"
                                                       Style="{StaticResource DifficultyBadgeTextStyle}" />
                                        </Border>
                                        <TextBlock Text="{Binding ChartDetailPlayStyleDisplay, Mode=OneWay}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Text=" / " Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ChartDetailLevelDisplay, Mode=OneWay}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </WrapPanel>

                                    <Grid Grid.Row="2" Margin="0,18,0,0" MinWidth="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.25*" MinWidth="0" />
                                            <ColumnDefinition Width="1*" MinWidth="0" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" MinWidth="0" Margin="0,0,18,0">
                                            <TextBlock Text="通常スコアBEST"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ChartDetailBestScoreDisplay, Mode=OneWay}"
                                                       FontFamily="Consolas" FontSize="32" FontWeight="Bold"
                                                       Margin="0,3,0,0" />
                                            <WrapPanel Margin="0,6,0,0">
                                                <TextBlock Text="EX SCORE "
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ChartDetailBestExScoreDisplay, Mode=OneWay}"
                                                           FontFamily="Consolas" FontWeight="Bold" />
                                            </WrapPanel>
                                            <WrapPanel Margin="0,10,0,0">
                                                <Border Style="{StaticResource RankBadgeStyle}"
                                                        Tag="{Binding ChartDetailRankBadgeGroup, Mode=OneWay}"
                                                        Visibility="{Binding ChartDetailRankBadgeVisibility, Mode=OneWay}"
                                                        Margin="0,0,8,6">
                                                    <TextBlock Style="{StaticResource BadgeTextStyle}">
                                                        <Run Text="RANK " /><Run Text="{Binding ChartDetailRankDisplay, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Text="—"
                                                           Visibility="{Binding ChartDetailRankPlaceholderVisibility, Mode=OneWay}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="12" VerticalAlignment="Center" Margin="0,0,8,6" />
                                                <Border Style="{StaticResource ClearBadgeStyle}"
                                                        Tag="{Binding ChartDetailClearBadgeGroup, Mode=OneWay}"
                                                        Visibility="{Binding ChartDetailClearBadgeVisibility, Mode=OneWay}"
                                                        Margin="0,0,8,6">
                                                    <TextBlock Text="{Binding ChartDetailClearDisplay, Mode=OneWay}"
                                                               Style="{StaticResource BadgeTextStyle}" />
                                                </Border>
                                                <TextBlock Text="—"
                                                           Visibility="{Binding ChartDetailClearPlaceholderVisibility, Mode=OneWay}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="12" VerticalAlignment="Center" Margin="0,0,8,6" />
                                                <Border Style="{StaticResource FlareBadgeStyle}"
                                                        Tag="{Binding ChartDetailFlareBadgeGroup, Mode=OneWay}"
                                                        Visibility="{Binding ChartDetailFlareBadgeVisibility, Mode=OneWay}"
                                                        Margin="0,0,8,6">
                                                    <TextBlock Style="{StaticResource BadgeTextStyle}">
                                                        <Run Text="FLARE " /><Run Text="{Binding ChartDetailFlareRankDisplay, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Text="—"
                                                           Visibility="{Binding ChartDetailFlarePlaceholderVisibility, Mode=OneWay}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="12" VerticalAlignment="Center" Margin="0,0,8,6" />
                                            </WrapPanel>
                                        </StackPanel>

                                        <UniformGrid Grid.Column="1" Columns="2" MinWidth="0">
                                            <Border Background="{StaticResource SurfaceSecondaryBrush}"
                                                    BorderBrush="{StaticResource BorderDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="8"
                                                    Padding="11,9" Margin="0,0,6,6">
                                                <StackPanel>
                                                    <TextBlock Text="プレー回数" Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="11" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding ChartDetailPlayCountDisplay, Mode=OneWay}"
                                                               FontWeight="Bold" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{StaticResource SurfaceSecondaryBrush}"
                                                    BorderBrush="{StaticResource BorderDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="8"
                                                    Padding="11,9" Margin="6,0,0,6">
                                                <StackPanel>
                                                    <TextBlock Text="フルコンボ回数" Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="11" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding ChartDetailFullComboCountDisplay, Mode=OneWay}"
                                                               FontWeight="Bold" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{StaticResource SurfaceSecondaryBrush}"
                                                    BorderBrush="{StaticResource BorderDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="8"
                                                    Padding="11,9" Margin="0,6,6,0">
                                                <StackPanel>
                                                    <TextBlock Text="通常スコアBEST更新" Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="11" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding ChartDetailScoreBestAtDisplay, Mode=OneWay}"
                                                               FontSize="12" FontWeight="Bold" Margin="0,3,0,0"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{StaticResource SurfaceSecondaryBrush}"
                                                    BorderBrush="{StaticResource BorderDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="8"
                                                    Padding="11,9" Margin="6,6,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="EXスコアBEST更新" Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="11" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding ChartDetailExScoreBestAtDisplay, Mode=OneWay}"
                                                               FontSize="12" FontWeight="Bold" Margin="0,3,0,0"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </Grid>
                                    <TextBlock Grid.Row="3"
                                               Text="通常スコアとEXスコアの自己ベストは、それぞれの更新日時を基準に表示しています。"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Margin="18,15,18,0">
                                        <TextBlock Text="スコア推移" FontSize="16" FontWeight="Bold" />
                                        <TextBlock Text="プレーごとの通常スコアと自己ベスト更新点（グラフは直近100プレー）"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Grid Margin="18,12,18,18" MinWidth="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="0" />
                                            <ColumnDefinition Width="250" MinWidth="210" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" MinWidth="0" Margin="0,0,18,0">
                                            <StackPanel Orientation="Horizontal" Background="#F1F5F9"
                                                        HorizontalAlignment="Left" Margin="0,0,0,8">
                                                <Button x:Name="ChartDetailAllPlaysButton" Content="全プレー"
                                                        Tag="Selected" Style="{StaticResource BestStyleButtonStyle}"
                                                        Click="ChartDetailGraphMode_Click" />
                                                <Button x:Name="ChartDetailBestProgressionButton" Content="自己ベスト推移"
                                                        Tag="" Style="{StaticResource BestStyleButtonStyle}"
                                                        Click="ChartDetailGraphMode_Click" />
                                            </StackPanel>
                                            <WrapPanel Margin="0,0,0,4">
                                                <TextBlock Text="● 通常スコア" Foreground="{StaticResource AccentPrimaryBrush}"
                                                           FontSize="11" FontWeight="SemiBold" Margin="0,0,14,0" />
                                                <TextBlock Text="● 自己ベスト更新" Foreground="#059669"
                                                           FontSize="11" FontWeight="SemiBold" />
                                            </WrapPanel>
                                            <Grid MinWidth="0">
                                                <Canvas x:Name="ChartDetailGraphCanvas" Height="230"
                                                        Background="#F8FAFC"
                                                        SizeChanged="ChartDetailGraphCanvas_SizeChanged" />
                                                <TextBlock Text="未プレーのため、保存済みプレーはありません。"
                                                           Visibility="{Binding ChartDetailEmptyVisibility}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ChartDetailBestProgressionEmptyMessage, Mode=OneWay}"
                                                           Visibility="{Binding ChartDetailBestProgressionEmptyVisibility, Mode=OneWay}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </StackPanel>

                                        <Border Grid.Column="1"
                                                Background="{StaticResource SurfaceSecondaryBrush}"
                                                BorderBrush="{StaticResource BorderDefaultBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="14"
                                                VerticalAlignment="Top"
                                                Visibility="{Binding ChartDetailPlayVisibility}">
                                            <StackPanel MinWidth="0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="最新プレー" FontWeight="Bold" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding ChartDetailLatestPlay.Play.PlayedAtDisplay, Mode=OneWay}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="11" TextWrapping="Wrap" TextAlignment="Right" />
                                                </Grid>
                                                <TextBlock Text="{Binding ChartDetailLatestPlay.ScoreDisplay, Mode=OneWay}"
                                                           FontFamily="Consolas" FontSize="26" FontWeight="Bold"
                                                           Margin="0,12,0,0" />
                                                <WrapPanel Margin="0,4,0,0">
                                                    <TextBlock Text="EX SCORE " Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="11" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding ChartDetailLatestPlay.ExScoreDisplay, Mode=OneWay}"
                                                               FontFamily="Consolas" FontWeight="Bold" />
                                                </WrapPanel>
                                                <WrapPanel Margin="0,10,0,0">
                                                    <ContentControl Content="{Binding ChartDetailLatestPlay, Mode=OneWay}"
                                                                    ContentTemplate="{StaticResource RankBadgeOrPlaceholderTemplate}"
                                                                    Margin="0,0,6,5"
                                                                    HorizontalContentAlignment="Left"
                                                                    VerticalContentAlignment="Center" />
                                                    <ContentControl Content="{Binding ChartDetailLatestPlay, Mode=OneWay}"
                                                                    ContentTemplate="{StaticResource ClearBadgeOrPlaceholderTemplate}"
                                                                    Margin="0,0,6,5"
                                                                    HorizontalContentAlignment="Left"
                                                                    VerticalContentAlignment="Center" />
                                                    <ContentControl Content="{Binding ChartDetailLatestPlay, Mode=OneWay}"
                                                                    ContentTemplate="{StaticResource FlareBadgeOrPlaceholderTemplate}"
                                                                    Margin="0,0,0,5" />
                                                </WrapPanel>
                                                <Border BorderBrush="{StaticResource BorderDefaultBrush}"
                                                        BorderThickness="0,1,0,0" Padding="0,10,0,0"
                                                        Margin="0,8,0,0">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="通常スコア差" Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="11" FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding ChartDetailLatestPlay.ScoreBestDeltaDisplay, Mode=OneWay}"
                                                                       Style="{StaticResource HomeDeltaTextStyle}"
                                                                       Tag="{Binding ChartDetailLatestPlay.ScoreBestDeltaGroup, Mode=OneWay}" />
                                                        </Grid>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="EXスコア差" Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="11" FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding ChartDetailLatestPlay.ExScoreBestDeltaDisplay, Mode=OneWay}"
                                                                       Style="{StaticResource HomeDeltaTextStyle}"
                                                                       Tag="{Binding ChartDetailLatestPlay.ExScoreBestDeltaGroup, Mode=OneWay}" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Padding="0">
                                <StackPanel>
                                    <StackPanel Margin="18,15,18,12">
                                        <TextBlock Text="プレー履歴" FontSize="16" FontWeight="Bold" />
                                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11" Margin="0,3,0,0">
                                            <Run Text="この譜面の保存済みプレー " />
                                            <Run Text="{Binding ChartDetailHistoryCountDisplay, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="未プレーのため、記録・推移・履歴はありません。"
                                               Visibility="{Binding ChartDetailEmptyVisibility}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="18,0,18,18" TextWrapping="Wrap" />
                                    <DataGrid ItemsSource="{Binding ChartDetailHistory, Mode=OneWay}"
                                              Visibility="{Binding ChartDetailPlayVisibility, Mode=OneWay}"
                                              RowHeight="44" ColumnHeaderHeight="34"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                              Style="{StaticResource ViewerDataGridStyle}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="日時"
                                                                Binding="{Binding Play.PlayedAtDisplay, Mode=OneWay}"
                                                                Width="1.35*" />
                                            <DataGridTextColumn Header="SCORE"
                                                                Binding="{Binding ScoreDisplay, Mode=OneWay}"
                                                                Width="1*" />
                                            <DataGridTextColumn Header="EX SCORE"
                                                                Binding="{Binding ExScoreDisplay, Mode=OneWay}"
                                                                Width="1*" />
                                            <DataGridTemplateColumn Header="RANK" Width="0.85*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ContentControl Content="{Binding}"
                                                                        ContentTemplate="{StaticResource RankBadgeOrPlaceholderTemplate}"
                                                                        HorizontalContentAlignment="Left"
                                                                        VerticalContentAlignment="Center" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="CLEAR" Width="0.9*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ContentControl Content="{Binding}"
                                                                        ContentTemplate="{StaticResource ClearBadgeOrPlaceholderTemplate}"
                                                                        HorizontalContentAlignment="Left"
                                                                        VerticalContentAlignment="Center" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="FLARE" Width="1*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ContentControl Content="{Binding}"
                                                                        ContentTemplate="{StaticResource FlareBadgeOrPlaceholderTemplate}"
                                                                        HorizontalContentAlignment="Left"
                                                                        VerticalContentAlignment="Center" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="SCORE差" Width="1.1*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding ScoreBestDeltaDisplay, Mode=OneWay}"
                                                                   Style="{StaticResource HomeDeltaTextStyle}"
                                                                   Tag="{Binding ScoreBestDeltaGroup, Mode=OneWay}"
                                                                   TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="EX差" Width="1.1*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding ExScoreBestDeltaDisplay, Mode=OneWay}"
                                                                   Style="{StaticResource HomeDeltaTextStyle}"
                                                                   Tag="{Binding ExScoreBestDeltaGroup, Mode=OneWay}"
                                                                   TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="18,10,18,18"
                                                Visibility="{Binding ChartDetailPlayVisibility, Mode=OneWay}">
                                        <Button Content="続きを見る"
                                                Style="{StaticResource HomeSectionLinkStyle}"
                                                Visibility="{Binding ChartDetailLoadMoreVisibility, Mode=OneWay}"
                                                Click="ChartDetailLoadMore_Click" />
                                        <TextBlock Text="{Binding ChartDetailHistoryLoadMoreHintDisplay, Mode=OneWay}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="260" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" MinHeight="210" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="0">
                            <DataGrid x:Name="RecentPlayGrid"
                                      ItemsSource="{Binding Plays}" SelectedItem="{Binding SelectedPlay}"
                                      ScrollViewer.ScrollChanged="RecentPlayGrid_ScrollChanged"
                                      Style="{StaticResource ViewerDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="日時" Binding="{Binding PlayedAtDisplay, Mode=OneWay}" Width="120" />
                                    <DataGridTextColumn Header="曲名" Binding="{Binding SongTitle, Mode=OneWay}" Width="2*" />
                                    <DataGridTemplateColumn Header="譜面" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource DifficultyBadgeStyle}">
                                                    <TextBlock Text="{Binding ChartDisplay}"
                                                               Style="{StaticResource DifficultyBadgeTextStyle}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Lv." Binding="{Binding LevelDisplay, Mode=OneWay}" Width="55" />
                                    <DataGridTextColumn Header="SCORE" Binding="{Binding ScoreDisplay, Mode=OneWay}" Width="110" />
                                    <DataGridTemplateColumn Header="ランク" Width="65">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl Content="{Binding}"
                                                                ContentTemplate="{StaticResource RankBadgeOrPlaceholderTemplate}"
                                                                HorizontalContentAlignment="Left"
                                                                VerticalContentAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="CLEAR" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl Content="{Binding}"
                                                                ContentTemplate="{StaticResource ClearBadgeOrPlaceholderTemplate}"
                                                                HorizontalContentAlignment="Left"
                                                                VerticalContentAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="FLARE" Width="85">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl Content="{Binding}"
                                                                ContentTemplate="{StaticResource FlareBadgeOrPlaceholderTemplate}"
                                                                HorizontalContentAlignment="Left"
                                                                VerticalContentAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <TextBlock Grid.Row="1"
                                   Text="{Binding RecentPlayLoadMoreHintDisplay, Mode=OneWay}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Margin="4,6,4,6" />

                        <Border Grid.Row="2" Style="{StaticResource CardStyle}" DataContext="{Binding SelectedPlay}"
                                Padding="20,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*" />
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="1.2*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <TextBlock Text="{Binding SongTitle}" FontSize="18" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border Style="{StaticResource DifficultyBadgeStyle}">
                                            <TextBlock Text="{Binding Difficulty}"
                                                       Style="{StaticResource DifficultyBadgeTextStyle}" />
                                        </Border>
                                        <TextBlock Text="  " />
                                        <TextBlock Text="{Binding PlayStyleDisplay}" FontWeight="SemiBold" />
                                        <TextBlock Text=" / " />
                                        <TextBlock Text="{Binding LevelDisplay}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ScoreDisplay}" FontSize="32" FontWeight="Bold" />
                                        <TextBlock Margin="16,0,0,0" VerticalAlignment="Bottom"
                                                   Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="EX SCORE: " />
                                            <Run Text="{Binding ExScoreDisplay, Mode=OneWay}" FontWeight="Bold" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <ContentControl Content="{Binding}"
                                                        ContentTemplate="{StaticResource RankBadgeOrPlaceholderTemplate}"
                                                        Margin="0,0,6,0"
                                                        HorizontalContentAlignment="Left"
                                                        VerticalContentAlignment="Center" />
                                        <ContentControl Content="{Binding}"
                                                        ContentTemplate="{StaticResource ClearBadgeOrPlaceholderTemplate}"
                                                        Margin="0,0,6,0"
                                                        HorizontalContentAlignment="Left"
                                                        VerticalContentAlignment="Center" />
                                        <ContentControl Content="{Binding}"
                                                        ContentTemplate="{StaticResource FlareBadgeOrPlaceholderTemplate}"
                                                        HorizontalContentAlignment="Left"
                                                        VerticalContentAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#F8FAFC"
                                        BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="14,12" Margin="0,0,20,0"
                                        VerticalAlignment="Center">
                                    <ItemsControl ItemsSource="{Binding JudgementBreakdown}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3,8,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12"
                                                               FontWeight="Bold" FontFamily="Consolas"
                                                               HorizontalAlignment="Right" Margin="8,0,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="プレー日時" FontWeight="SemiBold" />
                                    <Separator Margin="0,8" />
                                    <TextBlock Text="{Binding PlayedAtDisplay}"
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="0,0,8,0">
                        <StackPanel MinWidth="0">
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="設定項目" FontSize="15" FontWeight="SemiBold" />
                                <Button Content="初期値に戻す"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="ResetSettings_Click" />
                            </Grid>

                            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="自動記録" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="起動時の監視と保存できない結果の通知を設定します"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11" Margin="0,3,0,12" />
                                    <CheckBox Content="アプリ起動時に監視を開始"
                                              IsChecked="{Binding StartMonitoringOnLaunch, Mode=TwoWay}"
                                              FontSize="13" Margin="0,0,0,12" />
                                    <CheckBox Content="保存できない結果を通知"
                                              IsChecked="{Binding NotifyUnresolvedResults, Mode=TwoWay}"
                                              FontSize="13" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="表示" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="自己ベストの初期表示と起動時の画面を設定します"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11" Margin="0,3,0,12" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="既定のプレイスタイル"
                                                   VerticalAlignment="Center" FontSize="12" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button x:Name="SettingsSinglePlayStyleButton" Content="SINGLE"
                                                    Style="{StaticResource SettingsSinglePlayStyleButtonStyle}"
                                                    Click="SettingsSinglePlayStyle_Click" />
                                            <Button x:Name="SettingsDoublePlayStyleButton" Content="DOUBLE"
                                                    Style="{StaticResource SettingsDoublePlayStyleButtonStyle}"
                                                    Click="SettingsDoublePlayStyle_Click" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="起動時に表示する画面"
                                                   VerticalAlignment="Center" FontSize="12" />
                                        <ComboBox Grid.Column="1" Width="180" HorizontalAlignment="Left"
                                                  ItemsSource="{Binding StartupPageOptions}"
                                                  DisplayMemberPath="Display"
                                                  SelectedItem="{Binding SelectedStartupPageOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="言語" VerticalAlignment="Center" FontSize="12" />
                                        <ComboBox Grid.Column="1" Width="180" HorizontalAlignment="Left"
                                                  ItemsSource="{Binding LanguageOptions}"
                                                  DisplayMemberPath="Display"
                                                  SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    <TextBlock Text="言語の変更を保存するとアプリが自動的に再起動します"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11" Margin="220,8,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SettingsStatusMessage}"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,0,16,0" />
                                    <Button Grid.Column="1" Content="変更を保存"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="SaveSettings_Click" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="0,0,8,0">
                        <StackPanel MinWidth="0">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource HomeSummaryCardStyle}"
                                        Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="保存済みプレー"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11" />
                                        <TextBlock Text="{Binding DataManagementPlayCountDisplay}"
                                                   FontSize="20" FontWeight="Bold" Margin="0,5,0,0" />
                                        <TextBlock Text="個人スコアデータ"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="10" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource HomeSummaryCardStyle}"
                                        Margin="4,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="自己ベスト譜面"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11" />
                                        <TextBlock Text="{Binding DataManagementBestChartCountDisplay}"
                                                   FontSize="20" FontWeight="Bold" Margin="0,5,0,0" />
                                        <TextBlock Text="SINGLE / DOUBLE"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="10" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource HomeSummaryCardStyle}"
                                        Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="データ状態"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11" />
                                        <TextBlock Text="{Binding PersonalScoreDataStatusDisplay}"
                                                   FontSize="20" FontWeight="Bold" Margin="0,5,0,0" />
                                        <TextBlock Text="{Binding DataManagementLastSavedDisplay}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="10" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="保存データ" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="最後の保存" Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11" Margin="0,10,0,2" />
                                        <TextBlock Text="{Binding DataManagementLastSavedDisplay}"
                                                   FontSize="13" />
                                        <TextBlock Text="データ状態" Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11" Margin="0,8,0,2" />
                                        <TextBlock Text="{Binding PersonalScoreDataStatusDisplay}"
                                                   FontSize="13" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="個人スコアデータの退避・復元"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Margin="0,0,0,10" />
                                        <Button Content="バックアップを作成"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                IsEnabled="{Binding CanManagePersonalData}"
                                                Click="CreatePersonalScoreBackup_Click" />
                                        <Button Content="バックアップから復元"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                IsEnabled="{Binding CanManagePersonalData}"
                                                Click="RestorePersonalScoreBackup_Click"
                                                Margin="0,8,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="楽曲・譜面データ" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="アプリに同梱された楽曲・譜面情報"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11" Margin="0,3,0,12" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="状態" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11" />
                                            <TextBlock Text="{Binding BundledDataStatusDisplay}"
                                                       FontSize="13" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="データバージョン" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11" />
                                            <TextBlock Text="{Binding BundledDataVersionDisplay}"
                                                       FontSize="13" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="収録譜面数" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11" />
                                            <TextBlock Text="{Binding BundledChartCountDisplay}"
                                                       FontSize="13" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="初回はアプリ同梱データを使用し、起動時に新しい楽曲・譜面データを確認します。"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                    CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                                <TextBlock Text="{Binding DataManagementStatusMessage}"
                                           Foreground="#1E40AF" FontSize="11" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
