                                   FontSize="12" Margin="16,0,16,0" />
                        <Button x:Name="StartMonitoringButton" Grid.Column="2" Padding="12,5" FontSize="12"
                                Content="{Binding MonitoringStartActionDisplay, Mode=OneWay}"
                                Visibility="{Binding MonitoringStartActionVisibility, Mode=OneWay}"
                                IsEnabled="{Binding CanStartMonitoring}"
                                TabIndex="90"
                                Click="StartContinuousCaptureAndSave_Click"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0" />
                        <Button x:Name="StopMonitoringButton" Grid.Column="3" Padding="12,5" FontSize="12" Content="監視を停止する"
                                IsEnabled="{Binding CanStopMonitoring}"
                                TabIndex="91"
                                Click="StopContinuousCapture_Click"
                                Margin="8,0,0,0">
                            <Button.Style>
                                <Style BasedOn="{StaticResource SecondaryButtonStyle}" TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanStopMonitoring}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
