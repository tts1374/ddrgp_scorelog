                                                    Click="OpenPublicPlayerPage_Click" />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,10,0,0" Visibility="{Binding WebRegisteredActionsVisibility}">
                                            <Button x:Name="OpenWebProfileButton" Content="マイプロフィールを開く"
                                                    Style="{StaticResource SecondaryButtonStyle}" Click="OpenWebProfile_Click" />
                                        </WrapPanel>
                                        <Expander x:Name="WebConnectionExpander" Header="アカウント" Margin="0,12,0,0"
                                                Foreground="{DynamicResource TextPrimaryBrush}">
                                            <StackPanel Margin="18,8,0,0">
                                                <Button Content="このPCの連携情報を削除" Margin="0,10,0,0" HorizontalAlignment="Left"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Visibility="{Binding WebBestAuthActionVisibility}"
                                                        Click="CheckWebBestIdentity_Click" />
                                                <WrapPanel Visibility="{Binding WebRegisteredActionsVisibility}">
                                                    <Button x:Name="GoogleConnectButton" Content="Googleを連携"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Visibility="{Binding GoogleConnectVisibility}"
                                                            IsEnabled="{Binding CanBeginWebAuthorization}" Click="ConnectWebAccount_Click" />
                                                    <Button x:Name="GoogleUnlinkButton" Content="Google連携を解除"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Visibility="{Binding GoogleUnlinkVisibility}"
                                                            IsEnabled="{Binding CanBeginWebAuthorization}" Click="UnlinkGoogle_Click" />
                                                    <Button x:Name="GoogleSettingsButton" Content="Google連携の設定をWebで開く"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Visibility="{Binding GoogleSettingsVisibility}" Click="OpenWebProfile_Click" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Expander>
                                        <TextBlock Text="{Binding WebAuthorizationMessage}" FontSize="12" Margin="0,10,0,0"
                                                Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                        <WrapPanel Margin="0,8,0,0" Visibility="{Binding WebAuthorizationPendingVisibility}">
                                            <Button Content="連携結果を確認" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                                                    IsEnabled="{Binding CanBeginWebAuthorization}" Click="ConfirmWebAuthorizationResult_Click" />
                                            <Button Content="連携をキャンセル" Margin="0,0,8,8"
                                                    Style="{StaticResource SecondaryButtonStyle}" Click="CancelWebAuthorization_Click" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                        <Border x:Name="SettingsSaveBar" Grid.Row="1" BorderBrush="{DynamicResource BorderDefaultBrush}"
                                Background="{DynamicResource SurfacePrimaryBrush}" CornerRadius="6" BorderThickness="1" Padding="16,12" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding SettingsStatusMessage}"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        FontSize="12" TextWrapping="Wrap" Margin="0,0,16,0" />
                                <Button x:Name="SaveSettingsButton" Grid.Column="1" Content="変更を保存"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="SaveSettings_Click" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem>
                    <ScrollViewer x:Name="RecordsBodyScrollViewer" HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel MinWidth="0">
                            <Border Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,0,16"><Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Padding="0"
                                        Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="保存済みプレー"
                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                FontSize="12" />
                                        <TextBlock Text="{Binding DataManagementPlayCountDisplay}"
                                                FontSize="20" FontWeight="Bold" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Padding="0"
                                        Margin="4,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="自己ベスト譜面"
                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                FontSize="12" />
                                        <TextBlock Text="{Binding DataManagementBestChartCountDisplay}"
                                                FontSize="20" FontWeight="Bold" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Padding="0"
                                        Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="データ状態"
                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                FontSize="12" />
                                        <TextBlock Text="{Binding PersonalScoreDataStatusDisplay}"
                                                FontSize="20" FontWeight="Bold" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid></Border>
                            <Grid x:Name="RecordsColumns">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.85*" />
                                    <ColumnDefinition Width="1.15*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel x:Name="RecordStoragePanel" Margin="0,0,24,0">
                                    <Border x:Name="RecordCopyCard" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="保存データ" FontSize="14" FontWeight="SemiBold" />
                                            <WrapPanel Margin="0,12,0,0">
                                                <TextBlock Text="最後の保存" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,16,4" />
                                                <TextBlock Text="{Binding DataManagementLastSavedDisplay}" FontSize="12" />
                                            </WrapPanel>
                                            <WrapPanel Margin="0,12,0,0">
                                                <Button x:Name="SaveRecordCopyButton" Content="バックアップを作成" Margin="0,0,8,0"
                                                        Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanManagePersonalData}"
                                                        Click="CreatePersonalScoreBackup_Click" />
                                                <Button x:Name="RestoreRecordCopyButton" Content="バックアップから復元"
                                                        Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanManagePersonalData}"
                                                        Click="RestorePersonalScoreBackup_Click" />
                                            </WrapPanel>
                                            <Expander x:Name="BackupScopeExpander" Header="バックアップの対象" FontSize="12" Margin="0,12,0,0"
                                                    Foreground="{DynamicResource TextPrimaryBrush}">
                                                <TextBlock Text="バックアップと復元は個人スコアデータだけを対象にします。"
                                                        TextWrapping="Wrap" Margin="18,6,0,0" FontSize="12"
                                                        Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="楽曲・譜面データ" FontSize="14" FontWeight="SemiBold" />
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="状態" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                                    <TextBlock Text="{Binding BundledDataStatusDisplay}" TextWrapping="Wrap" FontSize="13" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="収録譜面数" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding BundledChartCountDisplay}" FontSize="13" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Grid>
                                            <Expander x:Name="RecordInfoExpander" Header="詳しい情報" FontSize="12" Margin="0,12,0,0"
                                                    Foreground="{DynamicResource TextPrimaryBrush}">
                                                <StackPanel Margin="18,6,0,0">
                                                    <TextBlock Text="データバージョン" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding BundledDataVersionDisplay}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                    <TextBlock Text="初回はアプリ同梱データを使用し、起動時に新しい楽曲・譜面データを確認します。"
                                                            Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <Border x:Name="ImageImportCard" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="スクリーンショットからインポート"
                                                        FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,0" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource InfoBackgroundBrush}"
                                                    BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1"
                                                    CornerRadius="12" Padding="10,4" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding ScreenshotImportStateDisplay}"
                                                        Foreground="{DynamicResource InfoTextBrush}"
                                                        FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                        <Expander x:Name="ImageRequirementsExpander" Header="使える画像" FontSize="12" Margin="0,8,0,0"
                                                Foreground="{DynamicResource TextPrimaryBrush}">
                                            <TextBlock Text="PNG・1280×720の画像が使えます。" TextWrapping="Wrap" Margin="18,6,0,0"
                                                    Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                        </Expander>
                                        <Border Margin="0,14,0,0" Padding="20" CornerRadius="8"
                                                BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                                                Background="{DynamicResource SurfaceSecondaryBrush}"
                                                AllowDrop="True" PreviewDragOver="ScreenshotImport_DragOver"
                                                Drop="ScreenshotImport_Drop">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="PNGファイルをここにドラッグ＆ドロップ"
                                                        FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="複数ファイルを選択できます"
                                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                                        FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,10" />
                                                <Button x:Name="SelectResultImagesButton" Content="ファイルを選択"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        IsEnabled="{Binding CanStartScreenshotImport}"
                                                        Click="SelectScreenshots_Click" />
                                            </StackPanel>
                                        </Border>
                                        <Grid Margin="0,14,0,0"
                                                Visibility="{Binding ScreenshotImportProgressVisibility}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="{Binding ScreenshotImportProgressDisplay}"
                                                        FontSize="12" FontWeight="SemiBold" />
                                                <ProgressBar Minimum="0"
                                                        Maximum="{Binding ScreenshotImportTotalCount, Mode=OneWay}"
                                                        Value="{Binding ScreenshotImportCompletedCount, Mode=OneWay}"
                                                        Height="6" Margin="0,7,0,0" />
                                                <TextBlock Text="{Binding ScreenshotImportCurrentFileDisplay}"
                                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                                        FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                                            </StackPanel>
                                            <Button x:Name="CancelResultImagesButton" Grid.Column="1" Content="中断"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    IsEnabled="{Binding CanCancelScreenshotImport}"
                                                    Click="CancelScreenshotImport_Click"
                                                    VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel Margin="0,14,0,0"
                                                Visibility="{Binding ScreenshotImportResultsVisibility}">
                                            <TextBlock Text="{Binding ScreenshotImportSummaryDisplay}"
                                                    FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                                            <ItemsControl ItemsSource="{Binding ScreenshotImportResults}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                                BorderThickness="0,1,0,0" Padding="0,8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <TextBlock Text="{Binding StatusDisplay}" FontSize="12" FontWeight="SemiBold">
                                                                    <TextBlock.Style><Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="RecognitionFailed"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="InputError"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style></TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Grid.Column="1" Text="{Binding FileName}"
                                                                        FontSize="12" TextTrimming="CharacterEllipsis"
                                                                        Margin="8,0" />
                                                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0" Text="{Binding Message}"
                                                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                                                        FontSize="12" TextWrapping="Wrap" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Background="{DynamicResource InfoBackgroundBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataManagementStatusMessage}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding DataManagementStatusMessage}"
                                        Foreground="{DynamicResource InfoTextBrush}" FontSize="12" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
