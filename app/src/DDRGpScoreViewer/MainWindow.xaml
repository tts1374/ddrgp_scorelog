                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ContentControl Content="{Binding}"
                                                                        ContentTemplate="{StaticResource RankBadgeOrPlaceholderTemplate}"
                                                                        HorizontalContentAlignment="Left"
                                                                        VerticalContentAlignment="Center" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="CLEAR" MinWidth="92" Width="0.9*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ContentControl Content="{Binding}"
                                                                        ContentTemplate="{StaticResource ClearBadgeOrPlaceholderTemplate}"
                                                                        HorizontalContentAlignment="Left"
                                                                        VerticalContentAlignment="Center" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="FLARE" MinWidth="100" Width="1*">
