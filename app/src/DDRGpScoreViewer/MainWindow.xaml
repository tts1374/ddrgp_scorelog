                                        <TextBlock Text="{Binding LevelDisplay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Margin="0,8,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ScoreDisplay}" FontSize="32" FontWeight="Bold"
                                                   Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                        <TextBlock Margin="0,2,0,0" VerticalAlignment="Bottom"
