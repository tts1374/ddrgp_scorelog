                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding TotalDisplay}" FontSize="22" FontWeight="SemiBold"
                                           TextAlignment="Right" Typography.NumeralAlignment="Tabular" />
