<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Thickness x:Key="PanelPadding">16</Thickness>
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Yu Gothic UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource BackgroundPrimaryBrush}" />
    </Style>

    <!-- The focus ring is an adorner so it never changes a control's measured size. -->
    <Style x:Key="ControlFocusVisualStyle" TargetType="{x:Type Control}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource FocusRingBrush}"
                            BorderThickness="2"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <AdornedElementPlaceholder />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource AccentSolidBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentSolidBrush}" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentSolidHoverBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentSolidHoverBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentSolidPressedBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentSolidPressedBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="Selected" />
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="Selected" />
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentSolidPressedBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentSolidPressedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonTextBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{ComponentResourceKey ResourceId=DataGridSelectAllButtonStyle, TypeInTargetAssembly={x:Type DataGrid}}"
           TargetType="Button">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <Style x:Key="RailIconStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Width" Value="44" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="RailLabelStyle" TargetType="TextBlock">
        <Setter Property="Visibility" Value="{DynamicResource RailLabelVisibility}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SidebarButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
        <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="NavigationBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                        <Grid>
                            <Border x:Name="SelectedIndicator" Width="3" Height="22" CornerRadius="1.5"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"
                                    Background="{DynamicResource AccentPrimaryBrush}" />
                            <DockPanel>
                                <TextBlock Text="{TemplateBinding CommandParameter}" Style="{StaticResource RailIconStyle}"
                                           DockPanel.Dock="Left" />
                                <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource RailLabelStyle}" />
                            </DockPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NavigationBorder" Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Selected">
                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter TargetName="NavigationBorder" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                            <Setter TargetName="SelectedIndicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="NavigationBorder" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InlineRankStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="Upper"><Setter Property="Foreground" Value="{DynamicResource RankUpperTextBrush}" /></Trigger>
            <Trigger Property="Tag" Value="B"><Setter Property="Foreground" Value="{DynamicResource RankBTextBrush}" /></Trigger>
            <Trigger Property="Tag" Value="C"><Setter Property="Foreground" Value="{DynamicResource RankCTextBrush}" /></Trigger>
            <Trigger Property="Tag" Value="D"><Setter Property="Foreground" Value="{DynamicResource RankDTextBrush}" /></Trigger>
            <Trigger Property="Tag" Value="E"><Setter Property="Foreground" Value="{DynamicResource RankETextBrush}" /></Trigger>
        </Style.Triggers>
    </Style>


    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Outline" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                            Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Outline" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                            <Setter Property="Opacity" Value="0.6" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RailActionStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="3,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
        <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid>
                        <TextBlock Text="{Binding}" Style="{StaticResource RailLabelStyle}"
                                   TextWrapping="Wrap" TextAlignment="Center" />
                        <TextBlock Text="{Binding CommandParameter, RelativeSource={RelativeSource AncestorType=Button}}"
                                   FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   Visibility="{DynamicResource RailIconOnlyVisibility}" />
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScorebookSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="ScorebookCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style x:Key="ScorebookNumberStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Column.DisplayIndex, RelativeSource={RelativeSource Self}}" Value="0">
                <Setter Property="Padding" Value="13,5,6,5" />
                <Setter Property="BorderThickness" Value="3,0,0,0" />
            </DataTrigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource RowHoverBrush}" /></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Style.Triggers>
            <Trigger Property="DisplayIndex" Value="0"><Setter Property="Padding" Value="16,8" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="LastTableCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Padding" Value="6,5,16,5" />
    </Style>
    <Style x:Key="LastTableHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="Padding" Value="6,8,16,8" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="ToggleBorder" Background="{DynamicResource SurfacePrimaryBrush}"
                                            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="4">
                                        <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="10,5,30,5" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False">
                            <Border Background="{DynamicResource SurfacePrimaryBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                                    BorderThickness="1" CornerRadius="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}" Padding="4">
                                <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="{DynamicResource PanelPadding}" />
    </Style>

    <Style x:Key="ViewerDataGridStyle" TargetType="DataGrid">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeight" Value="56" />
        <Setter Property="ColumnHeaderHeight" Value="38" />
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
        <Setter Property="RowBackground" Value="{DynamicResource SurfacePrimaryBrush}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfacePrimaryBrush}" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- Rank, CLEAR, and FLARE share one visual box. Only the state colors and
         the content-dependent minimum width vary between badge types. -->
    <Style x:Key="ResultBadgeStyle" TargetType="Border">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="MinHeight" Value="27" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeNeutralTextBrush}" />
    </Style>

    <Style x:Key="RankBadgeStyle" TargetType="Border"
           BasedOn="{StaticResource ResultBadgeStyle}">
        <Setter Property="Background" Value="{DynamicResource BadgeNeutralBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BadgeNeutralBorderBrush}" />
        <Setter Property="MinWidth" Value="42" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Upper">
                <Setter Property="Background" Value="{DynamicResource BadgeGoldBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeGoldBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeGoldTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="B">
                <Setter Property="Background" Value="{DynamicResource BadgeCyanBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeCyanBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeCyanTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="C">
                <Setter Property="Background" Value="{DynamicResource BadgePinkBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgePinkBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgePinkTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="D">
                <Setter Property="Background" Value="{DynamicResource BadgeRedBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeRedBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeRedTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="E">
                <Setter Property="Background" Value="{DynamicResource BadgeNeutralBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeNeutralBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeNeutralTextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ClearBadgeStyle" TargetType="Border"
           BasedOn="{StaticResource ResultBadgeStyle}">
        <Setter Property="Background" Value="{DynamicResource BadgeNeutralBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BadgeNeutralBorderBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Mfc">
                <Setter Property="Background" Value="{DynamicResource BadgeRainbowBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeRainbowBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeRainbowTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Pfc">
                <Setter Property="Background" Value="{DynamicResource BadgeGoldBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeGoldBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeGoldTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Gfc">
                <Setter Property="Background" Value="{DynamicResource BadgeGreenBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeGreenBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeGreenTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Fc">
                <Setter Property="Background" Value="{DynamicResource BadgeBlueBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeBlueBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeBlueTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Clear">
                <Setter Property="Background" Value="{DynamicResource BadgeCyanBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeCyanBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeCyanTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Failed">
                <Setter Property="Background" Value="{DynamicResource BadgeRedBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeRedBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeRedTextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FlareBadgeStyle" TargetType="Border"
           BasedOn="{StaticResource ResultBadgeStyle}">
        <Setter Property="Background" Value="{DynamicResource BadgeNeutralBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BadgeNeutralBorderBrush}" />
        <Setter Property="MinWidth" Value="74" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="I">
                <Setter Property="Background" Value="{DynamicResource BadgeBlueBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeBlueBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeBlueTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="II">
                <Setter Property="Background" Value="{DynamicResource BadgeCyanBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeCyanBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeCyanTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="III">
                <Setter Property="Background" Value="{DynamicResource BadgeGreenBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeGreenBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeGreenTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="IV">
                <Setter Property="Background" Value="{DynamicResource BadgeYellowBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeYellowBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeYellowTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="V">
                <Setter Property="Background" Value="{DynamicResource BadgeOrangeBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeOrangeBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeOrangeTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="VI">
                <Setter Property="Background" Value="{DynamicResource BadgePurpleBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgePurpleBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgePurpleTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="VII">
                <Setter Property="Background" Value="{DynamicResource BadgeBronzeBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeBronzeBorderBrush}" />
