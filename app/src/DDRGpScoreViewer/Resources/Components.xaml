<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Yu Gothic UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource BackgroundPrimaryBrush}" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource AccentPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource FocusRingBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidebarButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="#94A3B8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="SidebarBorder" Background="{TemplateBinding Background}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SidebarBorder" Property="Background" Value="#29405F" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Selected">
                            <Setter TargetName="SidebarBorder" Property="Background" Value="{StaticResource AccentPrimaryBrush}" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfacePrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="ViewerDataGridStyle" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeight" Value="42" />
        <Setter Property="ColumnHeaderHeight" Value="36" />
        <Setter Property="Background" Value="{StaticResource SurfacePrimaryBrush}" />
        <Setter Property="RowBackground" Value="{StaticResource SurfacePrimaryBrush}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource SurfaceSecondaryBrush}" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- Rank, CLEAR, and FLARE share one visual box. Only the state colors and
         the content-dependent minimum width vary between badge types. -->
    <Style x:Key="ResultBadgeStyle" TargetType="Border">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="MinHeight" Value="27" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.Foreground" Value="#334155" />
    </Style>

    <Style x:Key="RankBadgeStyle" TargetType="Border"
           BasedOn="{StaticResource ResultBadgeStyle}">
        <Setter Property="Background" Value="#F1F5F9" />
        <Setter Property="BorderBrush" Value="#94A3B8" />
        <Setter Property="MinWidth" Value="42" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Upper">
                <Setter Property="Background" Value="#FEF3C7" />
                <Setter Property="BorderBrush" Value="#FACC15" />
                <Setter Property="TextElement.Foreground" Value="#854D0E" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="B">
                <Setter Property="Background" Value="#E0F2FE" />
                <Setter Property="BorderBrush" Value="#38BDF8" />
                <Setter Property="TextElement.Foreground" Value="#075985" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="C">
                <Setter Property="Background" Value="#FCE7F3" />
                <Setter Property="BorderBrush" Value="#F472B6" />
                <Setter Property="TextElement.Foreground" Value="#9D174D" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="D">
                <Setter Property="Background" Value="#FEE2E2" />
                <Setter Property="BorderBrush" Value="#EF4444" />
                <Setter Property="TextElement.Foreground" Value="#991B1B" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="E">
                <Setter Property="Background" Value="#F1F5F9" />
                <Setter Property="BorderBrush" Value="#94A3B8" />
                <Setter Property="TextElement.Foreground" Value="#334155" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ClearBadgeStyle" TargetType="Border"
           BasedOn="{StaticResource ResultBadgeStyle}">
        <Setter Property="Background" Value="#F1F5F9" />
        <Setter Property="BorderBrush" Value="#94A3B8" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Pfc">
                <Setter Property="Background" Value="#FEF3C7" />
                <Setter Property="BorderBrush" Value="#FACC15" />
                <Setter Property="TextElement.Foreground" Value="#854D0E" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Gfc">
                <Setter Property="Background" Value="#DCFCE7" />
                <Setter Property="BorderBrush" Value="#22C55E" />
                <Setter Property="TextElement.Foreground" Value="#166534" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Fc">
                <Setter Property="Background" Value="#DBEAFE" />
                <Setter Property="BorderBrush" Value="#2563EB" />
                <Setter Property="TextElement.Foreground" Value="#1E3A8A" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Clear">
                <Setter Property="Background" Value="#E0F2FE" />
                <Setter Property="BorderBrush" Value="#38BDF8" />
                <Setter Property="TextElement.Foreground" Value="#075985" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Mfc">
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FECACA" Offset="0" />
                            <GradientStop Color="#FEF3C7" Offset="0.25" />
                            <GradientStop Color="#DCFCE7" Offset="0.5" />
                            <GradientStop Color="#E0F2FE" Offset="0.75" />
                            <GradientStop Color="#F3E8FF" Offset="1" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderBrush" Value="#A855F7" />
                <Setter Property="TextElement.Foreground" Value="#0F172A" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Failed">
                <Setter Property="Background" Value="#FEE2E2" />
                <Setter Property="BorderBrush" Value="#EF4444" />
                <Setter Property="TextElement.Foreground" Value="#991B1B" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FlareBadgeStyle" TargetType="Border"
           BasedOn="{StaticResource ResultBadgeStyle}">
        <Setter Property="Background" Value="#F1F5F9" />
        <Setter Property="BorderBrush" Value="#94A3B8" />
        <Setter Property="MinWidth" Value="74" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="I">
                <Setter Property="Background" Value="#DBEAFE" />
                <Setter Property="BorderBrush" Value="#2563EB" />
                <Setter Property="TextElement.Foreground" Value="#1E3A8A" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="II">
                <Setter Property="Background" Value="#E0F2FE" />
                <Setter Property="BorderBrush" Value="#38BDF8" />
                <Setter Property="TextElement.Foreground" Value="#075985" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="III">
                <Setter Property="Background" Value="#DCFCE7" />
                <Setter Property="BorderBrush" Value="#22C55E" />
                <Setter Property="TextElement.Foreground" Value="#166534" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="IV">
                <Setter Property="Background" Value="#FEF3C7" />
                <Setter Property="BorderBrush" Value="#FACC15" />
                <Setter Property="TextElement.Foreground" Value="#854D0E" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="V">
                <Setter Property="Background" Value="#FEE2E2" />
                <Setter Property="BorderBrush" Value="#EF4444" />
                <Setter Property="TextElement.Foreground" Value="#991B1B" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="VI">
                <Setter Property="Background" Value="#EDE9FE" />
                <Setter Property="BorderBrush" Value="#8B5CF6" />
                <Setter Property="TextElement.Foreground" Value="#5B21B6" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="VII">
                <Setter Property="Background" Value="#E2E8F0" />
                <Setter Property="BorderBrush" Value="#94A3B8" />
                <Setter Property="TextElement.Foreground" Value="#334155" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="VIII">
                <Setter Property="Background" Value="#F1F5F9" />
                <Setter Property="BorderBrush" Value="#CBD5E1" />
                <Setter Property="TextElement.Foreground" Value="#334155" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="IX">
                <Setter Property="Background" Value="#FEF3C7" />
                <Setter Property="BorderBrush" Value="#FBBF24" />
                <Setter Property="TextElement.Foreground" Value="#854D0E" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="EX">
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FECACA" Offset="0" />
                            <GradientStop Color="#FEF3C7" Offset="0.25" />
                            <GradientStop Color="#DCFCE7" Offset="0.5" />
                            <GradientStop Color="#E0F2FE" Offset="0.75" />
                            <GradientStop Color="#F3E8FF" Offset="1" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderBrush" Value="#A855F7" />
                <Setter Property="TextElement.Foreground" Value="#0F172A" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DifficultyBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Difficulty}" Value="BEGINNER">
                <Setter Property="Background" Value="{StaticResource BeginnerBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Difficulty}" Value="BASIC">
                <Setter Property="Background" Value="{StaticResource BasicBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Difficulty}" Value="DIFFICULT">
                <Setter Property="Background" Value="{StaticResource DifficultBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Difficulty}" Value="EXPERT">
                <Setter Property="Background" Value="{StaticResource ExpertBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Difficulty}" Value="CHALLENGE">
                <Setter Property="Background" Value="{StaticResource ChallengeBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DifficultyBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Difficulty}" Value="DIFFICULT">
                <Setter Property="Foreground" Value="White" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Difficulty}" Value="EXPERT">
                <Setter Property="Foreground" Value="White" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Difficulty}" Value="CHALLENGE">
                <Setter Property="Foreground" Value="White" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
