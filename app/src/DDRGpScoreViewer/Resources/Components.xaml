<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Thickness x:Key="PanelPadding">16</Thickness>
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Yu Gothic UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource BackgroundPrimaryBrush}" />
    </Style>

    <!-- The focus ring is an adorner so it never changes a control's measured size. -->
    <Style x:Key="ControlFocusVisualStyle" TargetType="{x:Type Control}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource FocusRingBrush}"
                            BorderThickness="2"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <AdornedElementPlaceholder />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="Selected" />
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="Selected" />
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonTextBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{ComponentResourceKey ResourceId=DataGridSelectAllButtonStyle, TypeInTargetAssembly={x:Type DataGrid}}"
           TargetType="Button">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <Style x:Key="SidebarButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="16,18" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="NavigationBorder" Background="{TemplateBinding Background}"
                            BorderThickness="0,0,0,2" BorderBrush="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NavigationBorder" Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Selected">
                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="NavigationBorder" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                            <Setter TargetName="NavigationBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="NavigationBorder" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Outline" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                            Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Outline" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                            <Setter Property="Opacity" Value="0.6" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScorebookSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="ScorebookCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style x:Key="ScorebookNumberStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Column.DisplayIndex, RelativeSource={RelativeSource Self}}" Value="0">
                <Setter Property="Padding" Value="13,5,6,5" />
                <Setter Property="BorderThickness" Value="3,0,0,0" />
            </DataTrigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource RowHoverBrush}" /></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Style.Triggers>
            <Trigger Property="DisplayIndex" Value="0"><Setter Property="Padding" Value="16,8" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="LastTableCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Padding" Value="6,5,16,5" />
    </Style>
    <Style x:Key="LastTableHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="Padding" Value="6,8,16,8" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="ToggleBorder" Background="{DynamicResource SurfacePrimaryBrush}"
                                            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="4">
                                        <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="10,5,30,5" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False">
                            <Border Background="{DynamicResource SurfacePrimaryBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                                    BorderThickness="1" CornerRadius="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}" Padding="4">
                                <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="{DynamicResource PanelPadding}" />
    </Style>

    <Style x:Key="ViewerDataGridStyle" TargetType="DataGrid">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeight" Value="56" />
        <Setter Property="ColumnHeaderHeight" Value="38" />
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
        <Setter Property="RowBackground" Value="{DynamicResource SurfacePrimaryBrush}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfacePrimaryBrush}" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- Rank, CLEAR, and FLARE share one visual box. Only the state colors and
         the content-dependent minimum width vary between badge types. -->
    <Style x:Key="ResultBadgeStyle" TargetType="Border">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="MinHeight" Value="27" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeNeutralTextBrush}" />
    </Style>

    <Style x:Key="RankBadgeStyle" TargetType="Border"
           BasedOn="{StaticResource ResultBadgeStyle}">
        <Setter Property="Background" Value="{DynamicResource BadgeNeutralBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BadgeNeutralBorderBrush}" />
        <Setter Property="MinWidth" Value="42" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Upper">
                <Setter Property="Background" Value="{DynamicResource BadgeWarningBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeWarningBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeWarningTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="B">
                <Setter Property="Background" Value="{DynamicResource BadgeCyanBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeCyanBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeCyanTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="C">
                <Setter Property="Background" Value="{DynamicResource BadgePinkBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgePinkBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgePinkTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="D">
                <Setter Property="Background" Value="{DynamicResource BadgeDangerBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeDangerBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeDangerTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="E">
                <Setter Property="Background" Value="{DynamicResource BadgeNeutralBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeNeutralBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeNeutralTextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ClearBadgeStyle" TargetType="Border"
           BasedOn="{StaticResource ResultBadgeStyle}">
        <Setter Property="Background" Value="{DynamicResource BadgeNeutralBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BadgeNeutralBorderBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Pfc">
                <Setter Property="Background" Value="{DynamicResource BadgeWarningBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeWarningBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeWarningTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Gfc">
                <Setter Property="Background" Value="{DynamicResource BadgeSuccessBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeSuccessBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeSuccessTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Fc">
                <Setter Property="Background" Value="{DynamicResource BadgeInfoBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeInfoBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeInfoTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Clear">
                <Setter Property="Background" Value="{DynamicResource BadgeCyanBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeCyanBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeCyanTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Mfc">
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource MfcGradientDangerColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource MfcGradientWarningColor}" Offset="0.25" />
                            <GradientStop Color="{DynamicResource MfcGradientSuccessColor}" Offset="0.5" />
                            <GradientStop Color="{DynamicResource MfcGradientCyanColor}" Offset="0.75" />
                            <GradientStop Color="{DynamicResource MfcGradientPurpleColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeMfcBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeMfcTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Failed">
                <Setter Property="Background" Value="{DynamicResource BadgeDangerBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeDangerBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeDangerTextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FlareBadgeStyle" TargetType="Border"
           BasedOn="{StaticResource ResultBadgeStyle}">
        <Setter Property="Background" Value="{DynamicResource BadgeNeutralBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BadgeNeutralBorderBrush}" />
        <Setter Property="MinWidth" Value="74" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="I">
                <Setter Property="Background" Value="{DynamicResource BadgeInfoBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeInfoBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeInfoTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="II">
                <Setter Property="Background" Value="{DynamicResource BadgeCyanBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeCyanBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeCyanTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="III">
                <Setter Property="Background" Value="{DynamicResource BadgeSuccessBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeSuccessBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeSuccessTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="IV">
                <Setter Property="Background" Value="{DynamicResource BadgeWarningBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeWarningBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeWarningTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="V">
                <Setter Property="Background" Value="{DynamicResource BadgeDangerBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeDangerBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeDangerTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="VI">
                <Setter Property="Background" Value="{DynamicResource BadgePurpleBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgePurpleBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgePurpleTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="VII">
                <Setter Property="Background" Value="{DynamicResource BadgeSlateBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeSlateBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeSlateTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="VIII">
                <Setter Property="Background" Value="{DynamicResource BadgeNeutralBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeSlateBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeNeutralTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="IX">
                <Setter Property="Background" Value="{DynamicResource BadgeWarningBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeWarningStrongBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeWarningTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="EX">
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource MfcGradientDangerColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource MfcGradientWarningColor}" Offset="0.25" />
                            <GradientStop Color="{DynamicResource MfcGradientSuccessColor}" Offset="0.5" />
                            <GradientStop Color="{DynamicResource MfcGradientCyanColor}" Offset="0.75" />
                            <GradientStop Color="{DynamicResource MfcGradientPurpleColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderBrush" Value="{DynamicResource BadgeMfcBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeMfcTextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DifficultyBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Difficulty}" Value="BEGINNER">
                <Setter Property="Background" Value="{DynamicResource BeginnerBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Difficulty}" Value="BASIC">
                <Setter Property="Background" Value="{DynamicResource BasicBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Difficulty}" Value="DIFFICULT">
                <Setter Property="Background" Value="{DynamicResource DifficultBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Difficulty}" Value="EXPERT">
                <Setter Property="Background" Value="{DynamicResource ExpertBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Difficulty}" Value="CHALLENGE">
                <Setter Property="Background" Value="{DynamicResource ChallengeBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DifficultyBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Difficulty}" Value="DIFFICULT">
                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Difficulty}" Value="EXPERT">
                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Difficulty}" Value="CHALLENGE">
                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ScrollPageButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
            <Border x:Name="ThumbBorder" Background="{DynamicResource ScrollThumbBrush}" CornerRadius="4" Margin="2" />
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource TextSecondaryBrush}" /></Trigger>
                <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AccentPrimaryBrush}" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12" />
        <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButtonStyle}" /></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb Style="{StaticResource ScrollThumbStyle}" /></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButtonStyle}" /></Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" /><Setter Property="Height" Value="12" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="False">
                            <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPageButtonStyle}" /></Track.DecreaseRepeatButton>
                            <Track.Thumb><Thumb Style="{StaticResource ScrollThumbStyle}" /></Track.Thumb>
                            <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPageButtonStyle}" /></Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate></Setter.Value></Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{TemplateBinding Background}" /></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border x:Name="CheckBorder" Width="14" Height="14" Margin="0,2,8,2" VerticalAlignment="Center" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}" Background="{DynamicResource SurfacePrimaryBrush}">
                    <Path x:Name="Check" Data="M 2 6 L 5 9 L 10 2" Stroke="{DynamicResource PrimaryButtonTextBrush}" StrokeThickness="2" Visibility="Collapsed" />
                </Border>
                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True">
                    <ContentPresenter.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ContentPresenter.ContentTemplate>
                </ContentPresenter>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible" /><Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource AccentPrimaryBrush}" /><Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /><Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" /><Setter TargetName="Check" Property="Stroke" Value="{DynamicResource TextMutedBrush}" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ExpanderHeaderStyle" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
            <DockPanel Background="Transparent">
                <Path x:Name="Arrow" Data="M 0 0 L 5 4 L 0 8" Stroke="{DynamicResource AccentPrimaryBrush}" StrokeThickness="1.5" Width="8" Height="8" Margin="2,4,8,4" RenderTransformOrigin="0.5,0.5" />
                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
            </DockPanel>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /><Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource TextMutedBrush}" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
            <StackPanel>
                <ToggleButton x:Name="HeaderSite" Foreground="{TemplateBinding Foreground}" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Style="{StaticResource ExpanderHeaderStyle}" HorizontalContentAlignment="Left" />
                <ContentPresenter x:Name="ExpandSite" ContentSource="Content" Visibility="Collapsed" />
            </StackPanel>
            <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
