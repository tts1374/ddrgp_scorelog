    <Style x:Key="ColorLegendGroupTitleStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,10,0,2" />
    </Style>

    <Style x:Key="ColorLegendStyle" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="AutomationProperties.Name" Value="{DynamicResource 色の見方}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource 色の見方}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="RANK" Style="{StaticResource ColorLegendGroupTitleStyle}" />
                            <WrapPanel>
                                <Border Style="{StaticResource RankBadgeStyle}" Tag="Upper" Margin="0,4,6,0">
                                    <TextBlock Text="AAA–A-" Style="{StaticResource BadgeTextStyle}" />
                                </Border>
                                <Border Style="{StaticResource RankBadgeStyle}" Tag="B" Margin="0,4,6,0">
                                    <TextBlock Text="B+–B-" Style="{StaticResource BadgeTextStyle}" />
                                </Border>
                                <Border Style="{StaticResource RankBadgeStyle}" Tag="C" Margin="0,4,6,0">
                                    <TextBlock Text="C+–C-" Style="{StaticResource BadgeTextStyle}" />
                                </Border>
                                <Border Style="{StaticResource RankBadgeStyle}" Tag="D" Margin="0,4,6,0">
                                    <TextBlock Text="D+–D" Style="{StaticResource BadgeTextStyle}" />
                                </Border>
                                <Border Style="{StaticResource RankBadgeStyle}" Tag="E" Margin="0,4,6,0">
                                    <TextBlock Text="E" Style="{StaticResource BadgeTextStyle}" />
                                </Border>
                            </WrapPanel>
                            <TextBlock Text="CLEAR" Style="{StaticResource ColorLegendGroupTitleStyle}" />
                            <WrapPanel>
                                <Border Style="{StaticResource ClearBadgeStyle}" Tag="Mfc" Margin="0,4,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource ClearLampStyle}" Tag="Mfc" Margin="0,0,5,0" />
                                        <TextBlock Text="MFC" Style="{StaticResource BadgeTextStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource ClearBadgeStyle}" Tag="Pfc" Margin="0,4,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource ClearLampStyle}" Tag="Pfc" Margin="0,0,5,0" />
                                        <TextBlock Text="PFC" Style="{StaticResource BadgeTextStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource ClearBadgeStyle}" Tag="Gfc" Margin="0,4,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource ClearLampStyle}" Tag="Gfc" Margin="0,0,5,0" />
                                        <TextBlock Text="GFC" Style="{StaticResource BadgeTextStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource ClearBadgeStyle}" Tag="Fc" Margin="0,4,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource ClearLampStyle}" Tag="Fc" Margin="0,0,5,0" />
                                        <TextBlock Text="FC" Style="{StaticResource BadgeTextStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource ClearBadgeStyle}" Tag="Clear" Margin="0,4,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource ClearLampStyle}" Tag="Clear" Margin="0,0,5,0" />
                                        <TextBlock Text="CLEAR" Style="{StaticResource BadgeTextStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource ClearBadgeStyle}" Tag="Failed" Margin="0,4,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource ClearLampStyle}" Tag="Failed" Margin="0,0,5,0" />
                                        <TextBlock Text="FAILED" Style="{StaticResource BadgeTextStyle}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                            <TextBlock Text="FLARE" Style="{StaticResource ColorLegendGroupTitleStyle}" />
                            <WrapPanel>
                                <Border Style="{StaticResource FlareBadgeStyle}" Tag="I" Margin="0,4,6,0">
                                    <TextBlock Text="I" Style="{StaticResource BadgeTextStyle}" />
                                </Border>
                                <Border Style="{StaticResource FlareBadgeStyle}" Tag="II" Margin="0,4,6,0">
                                    <TextBlock Text="II" Style="{StaticResource BadgeTextStyle}" />
                                </Border>
                                <Border Style="{StaticResource FlareBadgeStyle}" Tag="III" Margin="0,4,6,0">
                                    <TextBlock Text="III" Style="{StaticResource BadgeTextStyle}" />
                                </Border>
                                <Border Style="{StaticResource FlareBadgeStyle}" Tag="IV" Margin="0,4,6,0">
                                    <TextBlock Text="IV" Style="{StaticResource BadgeTextStyle}" />
                                </Border>
                                <Border Style="{StaticResource FlareBadgeStyle}" Tag="V" Margin="0,4,6,0">
                                    <TextBlock Text="V" Style="{StaticResource BadgeTextStyle}" />
                                </Border>
                                <Border Style="{StaticResource FlareBadgeStyle}" Tag="VI" Margin="0,4,6,0">
                                    <TextBlock Text="VI" Style="{StaticResource BadgeTextStyle}" />
                                </Border>
                                <Border Style="{StaticResource FlareBadgeStyle}" Tag="VII" Margin="0,4,6,0">
                                    <TextBlock Text="VII" Style="{StaticResource BadgeTextStyle}" />
                                </Border>
                                <Border Style="{StaticResource FlareBadgeStyle}" Tag="VIII" Margin="0,4,6,0">
                                    <TextBlock Text="VIII" Style="{StaticResource BadgeTextStyle}" />
                                </Border>
                                <Border Style="{StaticResource FlareBadgeStyle}" Tag="IX" Margin="0,4,6,0">
                                    <TextBlock Text="IX" Style="{StaticResource BadgeTextStyle}" />
                                </Border>
                                <Border Style="{StaticResource FlareBadgeStyle}" Tag="EX" Margin="0,4,6,0">
                                    <TextBlock Text="EX" Style="{StaticResource BadgeTextStyle}" />
                                </Border>
                            </WrapPanel>
                            <TextBlock Text="{DynamicResource フレアスキルカテゴリ}" Style="{StaticResource ColorLegendGroupTitleStyle}" />
                            <WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,12,0">
                                    <Rectangle Style="{StaticResource FlareCategorySwatchStyle}" Tag="CLASSIC" Margin="0,0,5,0" />
                                    <TextBlock Text="CLASSIC (1st〜X3 VS 2ndMIX)" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,12,0">
                                    <Rectangle Style="{StaticResource FlareCategorySwatchStyle}" Tag="WHITE" Margin="0,0,5,0" />
                                    <TextBlock Text="WHITE (2013〜A)" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,12,0">
                                    <Rectangle Style="{StaticResource FlareCategorySwatchStyle}" Tag="GOLD" Margin="0,0,5,0" />
