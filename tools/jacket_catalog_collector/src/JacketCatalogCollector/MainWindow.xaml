<Window x:Class="JacketCatalogCollector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JacketCatalogCollector"
        Title="DDR GP ジャケット収集" Height="860" Width="1320"
        MinHeight="700" MinWidth="1040" Background="#F3F4F6"
        Loaded="MainWindow_Loaded">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="MinHeight" Value="36" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1976D2" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#1565C0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="52" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D8DEE8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F9FAFB" />
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:ManualReviewRoiImageConverter x:Key="ManualReviewRoiImageConverter" />
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Border Padding="12,7" Background="#F0FDF4" BorderBrush="#BBF7D0"
                    BorderThickness="1" CornerRadius="16" Margin="0,0,8,0">
                    <TextBlock Foreground="#166534">
                        <Run Text="{Binding MasterHeaderDisplay, Mode=OneWay}" />
                    </TextBlock>
                </Border>
                <Border Padding="12,7" Background="#EFF6FF" BorderBrush="#BFDBFE"
                    BorderThickness="1" CornerRadius="16">
                    <TextBlock Foreground="#1E40AF">
                        <Run Text="{Binding CatalogHeaderDisplay, Mode=OneWay}" />
                    </TextBlock>
                </Border>
                <Border Padding="12,7" Background="#EFF6FF" BorderBrush="#BFDBFE"
                    BorderThickness="1" CornerRadius="16" Margin="8,0,0,0">
                    <TextBlock Foreground="#1E40AF">
                        <Run Text="{Binding OfficialSnapshotHeaderDisplay, Mode=OneWay}" />
                    </TextBlock>
                </Border>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="DDR GP ジャケット収集" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="曲を切り替えながら、検出したジャケットを確認して保存します。"
                           Foreground="#6B7280" FontSize="12" Margin="0,3,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                    <TextBlock Text="{Binding StatusTitle, Mode=OneWay}"
                               FontWeight="SemiBold" Foreground="#1E40AF" />
                    <TextBlock Text="  " />
                    <TextBlock Text="{Binding StatusMessage, Mode=OneWay}"
                               Foreground="#5F6B7A" TextWrapping="Wrap" />
                </StackPanel>
                <ProgressBar Height="5" Margin="0,5,0,0" IsIndeterminate="True"
                             Visibility="{Binding IsBusy,
                                 Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="1" Background="White">
            <TabItem Header="ジャケット収集">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <Grid Margin="0,0,14,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="DDR GPの画面" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding WindowCapture.TargetDisplay}"
                                       FontWeight="SemiBold" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding WindowCapture.ConnectionDisplay}"
                                       Foreground="#166534" FontWeight="SemiBold"
                                       Margin="0,3,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding WindowCapture.CandidateStatus}"
                                       Foreground="#5F6B7A" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Grid.Row="1" BorderBrush="#293340" BorderThickness="1"
                                Background="#111820" CornerRadius="6">
                            <Image Source="{Binding WindowCapture.Preview}" Stretch="Uniform" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource Card}" Background="#EEF6FF">
                            <StackPanel>
                                <TextBlock Text="{Binding OperationStateDisplay}"
                                           FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
                                 <TextBlock Text="{Binding Observation.CollectionStateMessage}"
                                            Margin="0,8,0,14" Foreground="#44505F" FontSize="14"
                                            TextWrapping="Wrap" />
                                <CheckBox Content="保存前照合済み候補を自動保存 (既定OFF)"
                                          IsChecked="{Binding Observation.AutoSaveEnabled, Mode=TwoWay}"
                                          IsEnabled="{Binding Observation.CanConfigureAutoSave}"
                                          Margin="0,0,0,10" />
                                <Button Content="このジャケットを保存"
                                        Style="{StaticResource PrimaryButton}"
                                        IsEnabled="{Binding Observation.CanAdopt}"
                                        Click="AdoptObservation_Click" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="検出ステータス" FontSize="13" Foreground="#6B7280"
                                           FontWeight="SemiBold" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="曲名" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding Observation.DetectedTitleDisplay, Mode=OneWay}"
                                               />
                                    <TextBlock Grid.Row="1" Text="アーティスト" FontWeight="SemiBold"
                                               Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="{Binding Observation.DetectedArtistDisplay, Mode=OneWay}"
                                               Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="2" Text="判定状態" FontWeight="SemiBold"
                                               Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                               Text="{Binding Observation.CollectionJudgmentDisplay, Mode=OneWay}"
                                               Margin="0,8,0,0" Foreground="#166534" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <WrapPanel Margin="-4,8,0,0">
                            <Button Content="収集開始" IsEnabled="{Binding CanStartCollection}"
                                    Click="StartCapture_Click" />
                            <Button Content="収集を停止" IsEnabled="{Binding CanStopCollection}"
                                    Click="StopCapture_Click" />
                        </WrapPanel>

                        <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="収集終了結果" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CollectionEndResultDisplay, Mode=OneWay}"
                                           Foreground="#5F6B7A" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="収集状況">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10">
                        <UniformGrid Columns="5" Margin="0,0,0,10">
                            <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="収集済み" Foreground="#6B7280" />
                                    <TextBlock Text="{Binding CollectedCountDisplay, Mode=OneWay}"
                                               FontSize="22" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="レビュー待ち" Foreground="#6B7280" />
                                    <TextBlock Text="{Binding ReviewPendingSongCountDisplay, Mode=OneWay}"
                                               FontSize="22" FontWeight="SemiBold" Foreground="#B7791F" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="未収集" Foreground="#6B7280" />
                                    <TextBlock Text="{Binding UncollectedCountDisplay, Mode=OneWay}"
                                               FontSize="22" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="曲未特定" Foreground="#6B7280" />
                                    <TextBlock Text="{Binding UnresolvedCountDisplay, Mode=OneWay}"
                                               FontSize="22" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="曲情報外" Foreground="#6B7280" />
                                    <TextBlock Text="{Binding OrphanedCountDisplay, Mode=OneWay}"
                                               FontSize="22" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Text="状態" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox Width="190" ItemsSource="{Binding CoverageFilterOptions}"
                                          DisplayMemberPath="Display" SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedCoverageStatus}"
                                          Margin="0,0,12,0" />
                            </StackPanel>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{Binding CollectionOrphanSummaryDisplay, Mode=OneWay}"
                                           Foreground="#5F6B7A" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <DataGrid ItemsSource="{Binding Songs}"
                                  SelectedItem="{Binding SelectedCollectionSong, Mode=TwoWay}"
                                  IsReadOnly="True" AutoGenerateColumns="False"
                                  Margin="0,0,8,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="状態" Binding="{Binding CoverageStatusDisplay}" Width="150" />
                                <DataGridTextColumn Header="曲名" Binding="{Binding Title}" Width="2*" />
                                <DataGridTextColumn Header="アーティスト" Binding="{Binding Artist}" Width="*" />
                                <DataGridTextColumn Header="登録ジャケット数" Binding="{Binding ReferenceCount}" Width="120" />
                                <DataGridTextColumn Header="理由" Binding="{Binding ReasonDisplay}" Width="2*" />
                                <DataGridTextColumn Header="song ID" Binding="{Binding SongId}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="登録ジャケット詳細" FontSize="15"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1"
                                           Text="{Binding SelectedCollectionSongDisplay, Mode=OneWay}"
                                           Foreground="#5F6B7A" TextWrapping="Wrap" Margin="0,6,0,8" />
                                <DataGrid Grid.Row="2"
                                          ItemsSource="{Binding CollectionReferenceDetails}"
                                          SelectedItem="{Binding SelectedCollectionReference, Mode=TwoWay}"
                                          IsReadOnly="True" AutoGenerateColumns="False"
                                          HeadersVisibility="Column" CanUserAddRows="False"
                                          RowHeight="76">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="登録内容" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Click="PreviewCollectionReferenceImage_Click"
                                                            ToolTip="クリックで拡大表示"
                                                            Background="Transparent"
                                                            BorderBrush="Transparent"
                                                            BorderThickness="0"
                                                            Padding="0"
                                                            HorizontalContentAlignment="Center"
                                                            VerticalContentAlignment="Center">
                                                        <Image Source="{Binding SourceImagePath,
                                                            Converter={StaticResource ManualReviewRoiImageConverter},
                                                            ConverterParameter=full}"
                                                               Width="78" Height="62" Stretch="Uniform" />
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="状態"
                                                            Binding="{Binding ReviewStatus}"
                                                            Width="110" />
                                        <DataGridTextColumn Header="登録経路"
                                                            Binding="{Binding RegisteredRoute}"
                                                            Width="110" />
                                        <DataGridTextColumn Header="登録日時"
                                                            Binding="{Binding ProcessedAt}"
                                                            Width="160" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Grid.Row="3"
                                           Text="{Binding SelectedCollectionReferenceDisplay, Mode=OneWay}"
                                           Foreground="#5F6B7A" TextWrapping="Wrap" Margin="0,8,0,4" />
                                <Button Grid.Row="4" Content="登録ジャケットを削除"
                                        IsEnabled="{Binding CanDeleteSelectedCollectionReference}"
                                        Click="DeleteCollectionReference_Click"
                                        HorizontalAlignment="Right"
                                        Background="#FEF2F2" Foreground="#991B1B" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="レビュー">
                <TabControl Margin="0">
                    <TabItem Header="未レビュー">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                            CornerRadius="6" Padding="12,8" Margin="0,0,8,0">
                                        <TextBlock Foreground="#1E40AF" FontWeight="Bold">
                                            <Run Text="未レビュー  " />
                                            <Run Text="{Binding ManualReviewUnreviewedCount, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1"
                                            CornerRadius="6" Padding="12,8" Margin="0,0,8,0">
                                        <TextBlock Foreground="#065F46" FontWeight="Bold">
                                            <Run Text="確定  " />
                                            <Run Text="{Binding ManualReviewConfirmedCount, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                    <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1"
                                            CornerRadius="6" Padding="12,8" Margin="0,0,8,0">
                                        <TextBlock Foreground="#991B1B" FontWeight="Bold">
                                            <Run Text="却下  " />
                                            <Run Text="{Binding ManualReviewRejectedCount, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                    <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1"
                                            CornerRadius="6" Padding="12,8">
                                        <TextBlock Foreground="#92400E" FontWeight="Bold">
                                            <Run Text="保留  " />
                                            <Run Text="{Binding ManualReviewHoldCount, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Content="XLSXをエクスポート"
                                            IsEnabled="{Binding CanUseManualReviewActions}"
                                            Click="ExportManualReview_Click" />
                                    <Button Content="XLSXをインポート"
                                            IsEnabled="{Binding CanUseManualReviewActions}"
                                            Click="ImportManualReview_Click" />
                                    <Button Content="一括反映"
                                            Style="{StaticResource PrimaryButton}"
                                            IsEnabled="{Binding CanUseManualReviewActions}"
                                            Click="ApplyDrafts_Click" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="選択行のタイトルROI (拡大表示)" FontWeight="SemiBold"
                                               Foreground="#6B7280" Margin="0,0,0,8" />
                                    <Border Height="82" Background="#111827" BorderBrush="#374151"
                                            BorderThickness="1" CornerRadius="6" Padding="4">
                                        <Image Source="{Binding SelectedManualReviewRow.TitleRoiImagePath, Converter={StaticResource ManualReviewRoiImageConverter}, ConverterParameter=title}"
                                               Stretch="Uniform" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="選択行のアーティストROI (拡大表示)" FontWeight="SemiBold"
                                               Foreground="#6B7280" Margin="0,0,0,8" />
                                    <Border Height="82" Background="#111827" BorderBrush="#374151"
                                            BorderThickness="1" CornerRadius="6" Padding="4">
                                        <Image Source="{Binding SelectedManualReviewRow.ArtistRoiImagePath, Converter={StaticResource ManualReviewRoiImageConverter}, ConverterParameter=artist}"
                                               Stretch="Uniform" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <DataGrid Grid.Row="2" ItemsSource="{Binding ManualReviewRows}"
                                      SelectedItem="{Binding SelectedManualReviewRow, Mode=TwoWay}"
                                      IsReadOnly="False" AutoGenerateColumns="False" SelectionMode="Single"
                                      RowHeight="96" CanUserAddRows="False" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" Background="White">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="タイトルROI (切り出し画像)" Width="150" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding TitleRoiImagePath, Converter={StaticResource ManualReviewRoiImageConverter}, ConverterParameter=title}"
                                                       Width="120" Height="48" Stretch="Uniform" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="アーティストROI (切り出し画像)" Width="165" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding ArtistRoiImagePath, Converter={StaticResource ManualReviewRoiImageConverter}, ConverterParameter=artist}"
                                                       Width="130" Height="48" Stretch="Uniform" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="状態" Width="105">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding StatusOptions}"
                                                          DisplayMemberPath="Display"
                                                          SelectedValuePath="Value"
                                                          SelectedValue="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Margin="2" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="確定曲" Width="290">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBox Text="{Binding SongSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="title / alias / artist / song ID" />
                                                    <ComboBox ItemsSource="{Binding SongChoices}"
                                                              SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                                                              IsEditable="False">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Title}" />
                                                                    <TextBlock Text="{Binding Artist}" Foreground="#6B7280" FontSize="11" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <TextBlock Text="{Binding TruthSongDisplay, Mode=OneWay}"
                                                               Foreground="#6B7280" FontSize="11" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="メモ" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         MinHeight="58" AcceptsReturn="True" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="保存状態 / エラー" Width="165" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DraftStateDisplay}" TextWrapping="Wrap" Margin="4">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#EF4444" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSaved, Mode=OneWay}" Value="True">
                                                                    <Setter Property="Foreground" Value="#10B981" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="observation_id" Width="100" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding ObservationIdShort, Mode=OneWay}" ToolTip="{Binding ObservationId}"
                                                         IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                         FontFamily="Consolas" Margin="4" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="レビュー済み">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Margin="0,0,0,10"
                                       Text="現在の登録内容と、次回の反映予定を比較できます。変更なし・確定・reject・保留を選択し、下の一括反映で確定します。"
                                       Foreground="#5F6B7A" TextWrapping="Wrap" />
                            <DataGrid Grid.Row="1" ItemsSource="{Binding ReviewedManualReviewRows}"
                                      SelectedItem="{Binding SelectedReviewedManualReviewRow, Mode=TwoWay}"
                                      IsReadOnly="False" AutoGenerateColumns="False" SelectionMode="Single"
                                      RowHeight="104" CanUserAddRows="False" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" Background="White">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="現在の状態" Binding="{Binding CurrentStatusDisplay}" Width="105"
                                                        IsReadOnly="True" />
                                    <DataGridTemplateColumn Header="現在のsong" Width="250" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding CurrentSongDisplay}" TextWrapping="Wrap" Margin="4" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="反映予定" Width="105">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding StatusOptions}"
                                                          DisplayMemberPath="Display"
                                                          SelectedValuePath="Value"
                                                          SelectedValue="{Binding DraftStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Margin="2" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="予定song" Width="290">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBox Text="{Binding SongSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="title / alias / artist / song ID" />
                                                    <ComboBox ItemsSource="{Binding SongChoices}"
                                                              SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                                                              IsEditable="False">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Title}" />
                                                                    <TextBlock Text="{Binding Artist}" Foreground="#6B7280" FontSize="11" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <TextBlock Text="{Binding DraftSongDisplay, Mode=OneWay}"
                                                               Foreground="#6B7280" FontSize="11" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="メモ" Width="170">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         MinHeight="62" AcceptsReturn="True" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="登録経路 / 実行時刻" Width="210" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="4">
                                                    <TextBlock Text="{Binding RegisteredRoute}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding ProcessedAt}" Foreground="#6B7280"
                                                               FontSize="11" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="保存状態 / エラー" Width="165" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DraftStateDisplay}" TextWrapping="Wrap" Margin="4">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#EF4444" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSaved, Mode=OneWay}" Value="True">
                                                                    <Setter Property="Foreground" Value="#10B981" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="observation_id" Binding="{Binding ObservationIdShort}" Width="110"
                                                        IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>
            <TabItem Header="管理・設定">
                <StackPanel Margin="18" MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Text="管理・設定" FontSize="20" FontWeight="SemiBold" />
                    <Grid Margin="0,10,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,7,0">
                            <StackPanel>
                                <TextBlock Text="🎵 曲情報" FontWeight="Bold" FontSize="16" />
                                <TextBlock Text="{Binding MasterUserStatusDisplay, Mode=OneWay}"
                                           Foreground="#166534" Margin="0,6,0,8" />
                                <TextBlock Text="更新日時" Foreground="#6B7280" />
                                <TextBlock Text="{Binding MasterUpdatedAtLongDisplay, Mode=OneWay}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="曲数" Foreground="#6B7280" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding MasterSongCountDisplay, Mode=OneWay}" />
                                <TextBlock Text="譜面数" Foreground="#6B7280" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding MasterChartCountDisplay, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
                            <StackPanel>
                                <TextBlock Text="🖼️ ジャケット収集状況" FontWeight="Bold" FontSize="16" />
                                <TextBlock Text="{Binding CatalogUserStatusDisplay, Mode=OneWay}"
                                           Foreground="#166534" Margin="0,6,0,8" />
                                <TextBlock Text="ジャケット情報のバージョン" Foreground="#6B7280" />
                                <TextBlock Text="{Binding CatalogSchema, Mode=OneWay}" FontWeight="SemiBold" />
                                <TextBlock Text="収集済み曲数" Foreground="#6B7280" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding CatalogCoverageDisplay, Mode=OneWay}" />
                                <TextBlock Text="レビュー待ち件数" Foreground="#6B7280" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding ReviewPendingCountDisplay, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="7,0,0,0">
                            <StackPanel>
                                <TextBlock Text="🖼️ 公式ジャケット情報" FontWeight="Bold" FontSize="16" />
                                <TextBlock Text="{Binding OfficialSnapshotUserStatusDisplay, Mode=OneWay}"
                                           Foreground="#166534" Margin="0,6,0,8" />
                                <TextBlock Text="更新日時" Foreground="#6B7280" />
                                <TextBlock Text="{Binding OfficialSnapshotUpdatedAtDisplay, Mode=OneWay}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="取得曲数" Foreground="#6B7280" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding OfficialSnapshotSongCountDisplay, Mode=OneWay}" />
                                <TextBlock Text="保存画像数" Foreground="#6B7280" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding OfficialSnapshotStoredImageCountDisplay, Mode=OneWay}" />
                                <TextBlock Text="保存先" Foreground="#6B7280" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding OfficialSnapshotPathDisplay, Mode=OneWay}"
                                           FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource Card}" Width="880">
                        <StackPanel>
                            <TextBlock Text="データ更新" FontWeight="SemiBold" />
                            <TextBlock Text="収集中または他の更新処理中は実行できません。公式ジャケット情報の取得には時間がかかります。"
                                       Foreground="#5F6B7A" Margin="0,6,0,8" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="🔄 曲情報を更新" IsEnabled="{Binding CanUpdateMaster}"
                                        Click="UpdateMaster_Click" />
                                <Button Content="公式ジャケット情報を更新"
                                        IsEnabled="{Binding CanUpdateOfficialSnapshot}"
                                        Click="UpdateOfficialSnapshot_Click" />
                            </StackPanel>
                            <Border Margin="0,14,0,0" Padding="14"
                                    BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8"
                                    Visibility="{Binding IsOfficialSnapshotUpdating,
                                        Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding OfficialSnapshotProgressPercentDisplay,
                                            Mode=OneWay}" DockPanel.Dock="Right"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding OfficialSnapshotProgressTitleDisplay,
                                            Mode=OneWay}" Foreground="#1E40AF"
                                                   FontWeight="SemiBold" />
                                    </DockPanel>
                                    <ProgressBar Minimum="0" Maximum="100" Height="12"
                                                 Value="{Binding OfficialSnapshotProgressPercent,
                                                     Mode=OneWay}" />
                                    <TextBlock Text="{Binding OfficialSnapshotProgressDetailDisplay,
                                        Mode=OneWay}" Foreground="#6B7280" Margin="0,7,0,0" />
                                    <Button Content="取得をキャンセル"
                                            IsEnabled="{Binding CanCancelOfficialSnapshot}"
                                            Click="CancelOfficialSnapshot_Click"
                                            HorizontalAlignment="Right" Margin="4,12,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Width="880">
                        <StackPanel>
                            <TextBlock Text="最後の処理結果" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding OfficialSnapshotLastResultDisplay, Mode=OneWay}"
                                       Foreground="#5F6B7A" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding LastOperationResultDisplay, Mode=OneWay}"
                                       Foreground="#5F6B7A" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
