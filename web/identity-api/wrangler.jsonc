{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ddrgp-scorelog",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/api/*",
      "/player/*",
      "/my/*"
    ]
  },
  "vars": {
    "PUBLIC_WEB_ORIGIN": "https://ddrgp-scorelog.tts1374.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ddrgp-scorelog-web-db",
      "database_id": "9e7b336e-5880-4a47-a45d-375d2b5ab750",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "dev": {
      "name": "ddrgp-scorelog-dev",
      "vars": {
        "PUBLIC_WEB_ORIGIN": "https://ddrgp-scorelog-dev.tts1374.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ddrgp-scorelog-web-db-dev",
          "database_id": "fd9ce78f-90fe-4571-ac84-563330c10198",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
